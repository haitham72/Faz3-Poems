    {
      "parameters": {
        "jsCode": "// نقوم بالوصول إلى مصفوفة النتائج من المدخلات\nconst input = items[0].json; \nconst results = input.results || [];\n\nconst mappedResults = results.map(item => {\n  const meta = item.metadata || {};\n  \n  return {\n    // تحويل سلسلة المعرفات \"1,2,3\" إلى مصفوفة أرقام [1, 2, 3]\n    id: meta.Row_IDs_in_chunk ? meta.Row_IDs_in_chunk.split(',').map(Number) : [item.id],\n    \n    // البيانات الأساسية المطلوبة للـ HTML\n    poem_id: meta.poem_id,\n    content: item.content,\n    summary_text: item.content,\n    \n    // استخراج أول شعور (Sentiment) أو كائن فارغ\n    sentiments: (meta.sentiments && meta.sentiments.length > 0) ? meta.sentiments[0] : null,\n    \n    // استخراج المواضيع ككلمات مفتاحية للمطابقة\n    matched_metadata: meta.subjects ? meta.subjects.map(s => s.subject) : [],\n    \n    // تعيين قيم التشابه (Similarity) والمطابقة\n    semantic: item.similarity || 0,\n    exact_match: (item.similarity > 0.8),\n    trigram: 0,\n    fts: 0\n  };\n});\n\n// إرجاع النتيجة بالشكل النهائي المتوافق مع renderPoemCard\nreturn {\n  success: true,\n  count: mappedResults.length,\n  results: mappedResults\n};"
      },
