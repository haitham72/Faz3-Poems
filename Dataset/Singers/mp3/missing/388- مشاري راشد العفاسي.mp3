MDikgMVpSgGAB0RwDl_KPgdMgV3YXRjaMoBBGleSOc=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UCmMcOjsVehVlEOteyrhjI2Q"],"params":"CgIIAxILSWNlZFAzeGFWUWsYAA%3D%3D"}},"accessibility":{"label":"إلغاء الاشتراك"},"trackingParams":"CKQCEPBbIhMI7-a78MDikgMVpSgGAB0RwDl_"}},"cancelButton":{"buttonRenderer":{"style":"STYLE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"إلغاء"}]},"accessibility":{"label":"إلغاء"},"trackingParams":"CKMCEPBbIhMI7-a78MDikgMVpSgGAB0RwDl_"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CKACEM2rARgBIhMI7-a78MDikgMVpSgGAB0RwDl_"}},"showMoreText":{"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"trackingParams":"CKACEM2rARgBIhMI7-a78MDikgMVpSgGAB0RwDl_","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CKACEM2rARgBIhMI7-a78MDikgMVpSgGAB0RwDl_ygEEaV5I5w==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CKACEM2rARgBIhMI7-a78MDikgMVpSgGAB0RwDl_ygEEaV5I5w==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CKACEM2rARgBIhMI7-a78MDikgMVpSgGAB0RwDl_ygEEaV5I5w==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CKACEM2rARgBIhMI7-a78MDikgMVpSgGAB0RwDl_ygEEaV5I5w==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"من أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم\nألحان : فايز السعيد\nتوزيع : د. عدنان عبدالله\n\nالكلمات :\nبالهـدى والبر والتـقوى يا ربّــى زدها\nنفس مؤمن شفّـته بالذكر ليست عطبه\n\nأدرى أن المقبلات أشر وأقسى وأدهى\nوالعمـر مـرّه وأنـا لا يمكـن افرط به\n\nوأجمل اللحظات وأغلاها معى وأسعدها\nلحظةٍ راس قلمى فأوراقـى أخطط به\n\nالقصيدة دون حبكـه فى نظر ناقـدها\nمثل من صَلَّى صلاة الجمعة بلا خطبة\n\nوالبيوت اللى هجوسـى ماهو يرددها\nمن ملـف الذاكـرة ثـلثيـنها منشـطـبه\n\nصاحب النعمة ما يبلش غير فى حاسدها\nودّى أعرف حاسد النعمة فقط ما خطبه؟\n\nأيّها الإنسـان نفـسك للـعـلا جنّــدها\nواستمع شور المجرّب جيّدا واحتط به\n\nوانظر الحطّاب نفسه كيف هو عوّدها\nيْتخيّر فى الحطب ما كل عود أيحطبه\n\nلا تكن كـالبـير ما تـروى سوى قاصدها\nولتكن كالغـيم تـروى كل نفـسٍ رطـبه\n🔔 لا تنس دعم القناة بالاشتراك وتفعيل الجرس ليصلك كل جديد.\nاضغط إعجاب وشارك المقطع مع من تحب، فـ الدال على الخير كفاعله.\nحين تنشر تلاوة أو دعاء، فأنت تُعين على ذكر الله وتؤجر بإذن الله، فلعلها تكون سببًا لهداية قلب أو سكينة نفس.\nاستكشف المزيد من التلاوات، والمقاطع الهادفة والمميزة في قوائم التشغيل المتنوعة على القناة.\nبارك الله فيكم، ونفعنا وإياكم بالقرآن العظيم\n\nاشترك الآن في خدمة القرآن :\n   / @alafasy  \n\nاخترنا لك : 50 تلاوة مميزة للقارئ مشاري راشد العفاسي\n   • اخترنا لك : 60 تلاوة مميزة للقارئ مشاري را...  \n\nمصحف قديم الشيخ مشاري راشد العفاسي\n   • مصحف قديم الشيخ مشاري راشد العفاسي  \n\nمصحف كاليفورنيا من صلاة التراويح \n   • القرآن الكريم كاملاً من صلاة من التراويح و...  \n\nالمصحف المرتل الأول الذي سُجل في الكويت ومصر  عام 2003م 1424هـ\n   • المصحف المرتل الأول 2003م 1424هـ للشيخ مشا...  \n\nمصحف القرآءات العشر الجديد \n   • مصحف القراءات العشر 1445هـ - 2024م - الشيخ...  \n\nجميع أناشيد القارئ مشاري راشد العفاسي\n   • قصائد وأناشيد | مشاري راشد العفاسي  \n\nالأدعية وأذكار الصباح والمساء والرقية الشرعية\n   • Duaa' Mishary Alafasy أدعية وأذكار | مشاري...  ","commandRuns":[{"startIndex":1130,"length":15,"onTap":{"innertubeCommand":{"clickTrackingParams":"CKACEM2rARgBIhMI7-a78MDikgMVpSgGAB0RwDl_ygEEaV5I5w==","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCmMcOjsVehVlEOteyrhjI2Q","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCmMcOjsVehVlEOteyrhjI2Q","canonicalBaseUrl":"/channel/UCmMcOjsVehVlEOteyrhjI2Q"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: @alafasy"}}},{"startIndex":1200,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CKACEM2rARgBIhMI7-a78MDikgMVpSgGAB0RwDl_ygEEaV5I5w==","commandMetadata":{"webCommandMetadata":{"url":"/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN","webPageType":"WEB_PAGE_TYPE_PLAYLIST","rootVe":5754,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"VLPL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN","canonicalBaseUrl":"/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: اخترنا لك : 60 تلاوة مميزة للقارئ مشاري راشد العفاسي"}}},{"startIndex":1289,"length":41,"onTap":{"innertubeCommand":{"clickTrackingParams":"CKACEM2rARgBIhMI7-a78MDikgMVpSgGAB0RwDl_ygEEaV5I5w==","commandMetadata":{"webCommandMetadata":{"url":"/playlist?list=PL2hoGhz2jBSqc3yePg5cstFT3lpStFUb1","webPageType":"WEB_PAGE_TYPE_PLAYLIST","rootVe":5754,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"VLPL2hoGhz2jBSqc3yePg5cstFT3lpStFUb1","canonicalBaseUrl":"/playlist?list=PL2hoGhz2jBSqc3yePg5cstFT3lpStFUb1"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: مصحف قديم الشيخ مشاري راشد العفاسي"}}},{"startIndex":1366,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CKACEM2rARgBIhMI7-a78MDikgMVpSgGAB0RwDl_ygEEaV5I5w==","commandMetadata":{"webCommandMetadata":{"url":"/playlist?list=PL2hoGhz2jBSr0F3k9hIYqsllrqKlMLn1V","webPageType":"WEB_PAGE_TYPE_PLAYLIST","rootVe":5754,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"VLPL2hoGhz2jBSr0F3k9hIYqsllrqKlMLn1V","canonicalBaseUrl":"/playlist?list=PL2hoGhz2jBSr0F3k9hIYqsllrqKlMLn1V"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: القرآن الكريم كاملاً من صلاة من التراويح والقيام في كاليفورنيا | الشيخ مشاري راشد العفاسي