:4293105789,"overlayBackground":3426096650},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBYQ040EGAUiEwiDhPTwwOKSAxVbijcIHcY9PZbKAQTjhg9o","commandMetadata":{"webCommandMetadata":{"url":"/@alafasy","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCmMcOjsVehVlEOteyrhjI2Q","canonicalBaseUrl":"/@alafasy"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ZI3AaaDaAt3nBKbw5wytoZ3vsQJRSuAvb-a3kYk7tnBb8GlettafQO3zE_F_o4TKm0HJUDLyXQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"عرض المزيد"}},"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"attributedDescriptionBodyText":{"content":"🔔 لا تنس دعم القناة بالاشتراك وتفعيل الجرس ليصلك كل جديد.\nاضغط إعجاب وشارك المقطع مع من تحب، فـ الدال على الخير كفاعله.\nحين تنشر تلاوة أو دعاء، فأنت تُعين على ذكر الله وتؤجر بإذن الله، فلعلها تكون سببًا لهداية قلب أو سكينة نفس.\nاستكشف المزيد من التلاوات، والمقاطع الهادفة والمميزة في قوائم التشغيل المتنوعة على القناة.\nبارك الله فيكم، ونفعنا وإياكم بالقرآن العظيم\n\nاشترك الآن في خدمة القرآن :\n   / @alafasy  \n\nاخترنا لك : 50 تلاوة مميزة للقارئ مشاري راشد العفاسي\n   • اخترنا لك : 60 تلاوة مميزة للقارئ مشاري را...  \n\nمصحف قديم الشيخ مشاري راشد العفاسي\n   • مصحف قديم الشيخ مشاري راشد العفاسي  \n\nمصحف كاليفورنيا من صلاة التراويح \n   • القرآن الكريم كاملاً من صلاة من التراويح و...  \n\nالمصحف المرتل الأول الذي سُجل في الكويت ومصر  عام 2003م 1424هـ\n   • المصحف المرتل الأول 2003م 1424هـ للشيخ مشا...  \n\nمصحف القرآءات العشر الجديد \n   • مصحف القراءات العشر 1445هـ - 2024م - الشيخ...  \n\nجميع أناشيد القارئ مشاري راشد العفاسي\n   • قصائد وأناشيد | مشاري راشد العفاسي  \n\nالأدعية وأذكار الصباح والمساء والرقية الشرعية\n   • Duaa' Mishary Alafasy أدعية وأذكار | مشاري...  \n\nمن أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم \nألحان فايز السعيد\nتوزيع مصطفى قاسم واحمد سعيد\nاداء وهندسة صوتية \nمشاري راشد العفاسي\n\nالله خلق لي نفس تسـمو على البوح\n\nماهـيب لا ضاقـت من الهـم باحـت\n\nعلى كثر ما شفت ضيقات وجروح\n\nلا الوجه متغـيّر ولا العـين صاحت\n\nأبـشـّرك .. بـشـارة الـروح للـروح\n\nتـبي تطـيّحـني اللـيـالي و طـاحـت\n\nهـذا أنـا والـوجـه باسـم ومـشـروح\n\nوجهٍ بروقـه لمعـظم الناس لاحـت\n\nكم محزن ٍ بنى على شـوفه صروح\n\nوكم نفس من طارف عطاه استراحت\n\nألله وهـبـنا عـز و امجـاد و طمـوح\n\nوذكـر ٍعـلى جـدران الايـّـام ناحِـت\n\nهذي مراجل ماهي بضحك ومزوح\n\nماهي شموع لا ضوا الصبح ساحت\n\nالصـفح خصله والفخر ماله سطوح\n\nوالحزن لا سيطر على الروح ناحت\n\nبعض الجروح تجي لك شوي وتروح\n\nوبعض الجروح ان جات ماعاد راحت","commandRuns":[{"startIndex":394,"length":15,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBYQ040EGAUiEwiDhPTwwOKSAxVbijcIHcY9PZbKAQTjhg9o","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCmMcOjsVehVlEOteyrhjI2Q","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCmMcOjsVehVlEOteyrhjI2Q","canonicalBaseUrl":"/channel/UCmMcOjsVehVlEOteyrhjI2Q"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: @alafasy"}}},{"startIndex":464,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBYQ040EGAUiEwiDhPTwwOKSAxVbijcIHcY9PZbKAQTjhg9o","commandMetadata":{"webCommandMetadata":{"url":"/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN","webPageType":"WEB_PAGE_TYPE_PLAYLIST","rootVe":5754,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"VLPL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN","canonicalBaseUrl":"/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: اخترنا لك : 60 تلاوة مميزة للقارئ مشاري راشد العفاسي"}}},{"startIndex":553,"length":41,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBYQ040EGAUiEwiDhPTwwOKSAxVbijcIHcY9PZbKAQTjhg9o","commandMetadata":{"webCommandMetadata":{"url":"/pla