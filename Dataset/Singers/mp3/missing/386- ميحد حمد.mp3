MVd-ZJBx1kxzZ8ygEE-DXBlQ==","openPopupAction":{"popup":{"confirmDialogRenderer":{"trackingParams":"CIMCEMY4IhMI0Iao78DikgMVd-ZJBx1kxzZ8","dialogMessages":[{"runs":[{"text":"إنهاء الاشتراك في قناة \""},{"text":"Mubadart Hamdan Bin Mahmmad | مبادرة حمدان بن محمد للابداع الأدبي"},{"text":"\"؟"}]}],"confirmButton":{"buttonRenderer":{"style":"STYLE_BLUE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"إلغاء الاشتراك"}]},"serviceEndpoint":{"clickTrackingParams":"CIUCEPBbIhMI0Iao78DikgMVd-ZJBx1kxzZ8KPgdMgV3YXRjaMoBBPg1wZU=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UCuSEtWLpHvMFDXhyuaQM01A"],"params":"CgIIAxILWjM0bzZTTFJxRDQYAA%3D%3D"}},"accessibility":{"label":"إلغاء الاشتراك"},"trackingParams":"CIUCEPBbIhMI0Iao78DikgMVd-ZJBx1kxzZ8"}},"cancelButton":{"buttonRenderer":{"style":"STYLE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"إلغاء"}]},"accessibility":{"label":"إلغاء"},"trackingParams":"CIQCEPBbIhMI0Iao78DikgMVd-ZJBx1kxzZ8"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CP4BEM2rARgBIhMI0Iao78DikgMVd-ZJBx1kxzZ8"}},"showMoreText":{"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"trackingParams":"CP4BEM2rARgBIhMI0Iao78DikgMVd-ZJBx1kxzZ8","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CP4BEM2rARgBIhMI0Iao78DikgMVd-ZJBx1kxzZ8ygEE-DXBlQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CP4BEM2rARgBIhMI0Iao78DikgMVd-ZJBx1kxzZ8ygEE-DXBlQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CP4BEM2rARgBIhMI0Iao78DikgMVd-ZJBx1kxzZ8ygEE-DXBlQ==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CP4BEM2rARgBIhMI0Iao78DikgMVd-ZJBx1kxzZ8ygEE-DXBlQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"اشترك في قناة \" مبادرة حمدان بن محمد للابداع الأدبي\" الرسمية:\nhttps://goo.gl/QieNFb\n \nميحد حمد - أنا أنا \nMehad Hamad - Ana Ana\n\nمن أشعار : الشيخ حمدان بن محمد بن راشد آل مكتوم( فزاع )\nالحان : فايز السعيد\n\n\n‎الحـب لـو مايَـغـرقـك شـوق وَاشْـجـان \n‎تـعِــن مـن تـلــقــاء نـفـســك خـيـــوله \n‎وتــأسِّـسـه تـأسـيـس دولــه بْـعـنـــوان \n‎تعـيـش حـاكِـم حـب والـشــوق دولــــه \n‎تـْــبَـدّدَت كـل الـمـشــاعـر عـلى شـــان \n‎لان الـحـيـاه بْـلا مـشــاعـر خـجــولـــه \n‎أنـا .. أنـا لو عـشت فـي كـل الازمــان \n‎شـخـصـيِّـتي لي ..والـغــلا للّـي هـو لـه \n‎إلى هـنا يـاللـي تـقــول الـوعـــد حــان \n‎تـعـال قـل لي والـفـيـلـم وش فـصـولـه \n‎مْـجـامـَــل وْآهـــات وجْـــروح واحــزان \n‎وانــا مـرَشـَّــــحْـكــم لــدور الـبـطــولـه \n‎يمـكـن أجـامِـل نــاس أحـيـان واحْـيـان \n‎إلا مـصـيـري لـيه اقـول انـسـجـوا لـه \n‎إن قـلـتــوا اسـتـبـداد ... رَدّيـت والآن \n‎تـذكـَّـروا أحـلـى فـصــول الـطــفـــوله \n‎عـطــيْـتـكـم منـهـا لآلــيء ومـرجـــان \n‎والـيـوم خـلـّــونـي بْـــدور الـرجــــولـه \n\n‎ترى الـغـلا زوده مـع الـوقـت نـقـصـان \n‎إلى مــن يــحـبِّـــــك تـغــيَّــر مـيــــولـه \n\n‎هذا كـلام قـلـوب يـنطـق به انـســـان \n‎ويْـبـيـن فـي وجـهـه قـبـل ما يــقـولــه \n\n‎ماهـو كـلام انـسـان يـنطـق به لسـان \n‎إحـسـاسـه بْـمـعـنـاه مـاهـو بْـحــولـه \n\n‎تحسدني اصْحابي على جاه سلطان \n‎وتـحـسـدني اعـدائـي على ما أنـولـه \n\n‎والـمؤمـن الـصَّادق بفـطرته برهـان \n‎لـو ثـوبـه مْرقـَّع وحـفـيَـت رجــولـه \n\n‎حَـكـَّـايـة الـدنـيـا يـزيــدونـه ايْـمـان \n‎والفـاسـق ايْـمـانـه يقِـل ان حـكـوا له \n\n‎وانـا قـبـل يومـيـن قـلت الأنــا شــان \n‎وجْـه الـزمـان اللي ذبحـني فـضـوله \n\n‎قال العـقـل من قـلب يدفـعه وجْدان \n‎يـكـره مـظـاهـر للـحـيـاه الـعــجــوله \n\n‎ما كل شيّ إيْدك تطوله يا(حمدان) \n‎إحْـســاسـك يْـوافـق بأنـّـك تـطــوله \n\n‎وانا بَشَـر لي قلـب واحساس واعْيان \n‎وعـندي على التمـيـيز قدره مـهـوله \n\n‎إنسـان .. يمـلـكني مَعَ الوقت شيئان \n‎ربّـي وْديـنـي مـخـلّـده في رسـولـه \n\n‎لـذلك الإنـســــان يـا نــــاس لـو كــان \n‎بْـلا جَـــرءَة رأي .. تـثـقــل حـمـــولـه \n\n‎من ينـتـظـر فرصــه من فـلان وفـلان \n‎تلـقى مـقـام الـمجـد صعـبٍ وصوله \n\n#ميحد_حمد \n#ميحد_حمد_قديم \n#أنا_أنا\n\nتوزيع ديجيتال: شركة قنوات\nــــــــــــ \nOfficial Twitter:   / mubadara  \nOfficial Instagram:   / mubadara  \nOfficial Facebook: https://goo.gl/nOU7y2\nOfficial Google+: https://goo.gl/1XXMN3\nOfficial Youtube: https://goo.gl/mifdwF","commandRuns":[{"startIndex":62,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CP4BEM2rARgBIhMI0Iao78DikgMVd-ZJBx1kxzZ8SL7QxpaSnYq_Z8oBBPg1wZU=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbVZIdEd4aTJYZ0lWN2JZbDBoc3JycVhWOV9mQXxBQ3Jtc0ttdm9xVDVLcWQxRTRaSExHRnVWbjBmZ2ZyQXFEYVZVSlNvdVRsaTdhVy0yWnowelZOY2p6ZjZkek05S3VFMHIydUxLcUo5T2sxNXZvWE82dlh1NUdiSWhZYmRQOVM3TWhRb3lPT3pjNHlNNXBjRFVvQQ\u0026q=https%3A%2F%2Fgoo.gl%2FQieNFb\u0026v=Z34o6SLRqD4","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbVZIdEd4aTJYZ0lWN2JZbDBoc3JycVhWOV9mQXxBQ3Jtc0ttdm9xVDVLcWQxRTRaSExHRnVWbjBmZ2ZyQXFEYVZVSlNvdVRsaTdhVy0yWnowelZOY2p6ZjZkek05S3VFMHIydUxLcUo5T2sxNXZvWE82dlh1NUdiSWhZYmRQOVM3TWhRb3lPT3pjNHlNNXBjRFVvQQ\u0026q=https%3A%2F%2Fgoo.gl%2FQieNFb\u0026v=Z34o6SLRqD4","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":2020,"length":9,"onTap":{"innertubeCommand":{"clickTrackingParams":"CIECENzXBBgTIhMI0Iao78DikgMVd-ZJBx1kxzZ8ygEE-DXBlQ==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/%D9%85%D9%8A%D8%AD%D8%AF_%D8%AD%D9%85%D8%AF","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"bro