CEM2rARgBIhMItoD5oMDikgMVydpJBx09RAMk","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CP0CEM2rARgBIhMItoD5oMDikgMVydpJBx09RAMkygEEF_TkYQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CP0CEM2rARgBIhMItoD5oMDikgMVydpJBx09RAMkygEEF_TkYQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CP0CEM2rARgBIhMItoD5oMDikgMVydpJBx09RAMkygEEF_TkYQ==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CP0CEM2rARgBIhMItoD5oMDikgMVydpJBx09RAMkygEEF_TkYQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"اشترك في قناة الفنان راشد الماجد الرسمية\nhttp://goo.gl/quusYo\n\nراشد الماجد و حسين الجسمي - اسأل مجرب (النسخة الأصلية) | 2012\nRashed AlMajid \u0026 Hussain AlJassmi - Esaal Mjrb (Official Audio) | 2012\n\nكلمات: الشيخ حمدان بن محمد آل مكتوم (فزاع)\nألحان: فايز السعيد\nتوزيع ديجيتال: شركة قنوات\n\nكلمات الأغنية\nحبيبتي حالي من الشوق داني\nأشرق بحبك .. واعود أغرب\nأناني ف وصلك لكن يالأناني\nترى الأنانيه ف طبعك تخرب\nلحظات حبك حطّمت لي كياني\nوالحزن من بين المحاني تسرب\nتسرب وصكّت عليه المحاني\nكنّه لوصلك بالجروح يتقرب\nيامعرب الأنساب خدر العياني\nسلم العرب لاتجهله يالمعرب\nشربت حبّك لين فاض الحناني\nوقامت عروقي من غلاك تشرب\nياللي تقول اسأل مجرب تراني\nسألت واحد.... بس قام يتهرب\nلاتسأل مجرب ياقلب وتعاني\nإسأل طبيب وخل عنك المجرب\n--------\nتابع الفنان راشد الماجد الآن على الصفحات الرسمية\nOfficial Website: http://www.Rashed.TV\nOfficial iTunes http://apple.co/1KWSl9C\nOfficial iTunes Connect: https://itun.es/eg/E8amJ\nFollow on Twitter:   / rashedtv  \nLike on Facebook:   / rashedtv  \nFollow on Instagram:   / rashedtv  \nFollow on Google+: https://goo.gl/i4VMx9\nSubscribe on YouTube:    / rashedalmajid  ","commandRuns":[{"startIndex":41,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CP0CEM2rARgBIhMItoD5oMDikgMVydpJBx09RAMkSJrq9LGhvtTLnwHKAQQX9ORh","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbHBJRHhwbXJxSTJwUW9tdHNpb0ZucXJSazAtQXxBQ3Jtc0ttMVlQZEZhT1lmOXRqNlliQlN1YWd2WHBIWmN1a0N6THRBRmRFa3JkUkplSFd6WWZOV0tYdjJOR3VsUXdEQUQyU0s1UWV6by03eUFiMjBJTDZsM3I4eXlzWVpGZFR3d3Vyd2FZTzB6WmtmdGhGUTdITQ\u0026q=http%3A%2F%2Fgoo.gl%2FquusYo\u0026v=n5dR8hY9NRo","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbHBJRHhwbXJxSTJwUW9tdHNpb0ZucXJSazAtQXxBQ3Jtc0ttMVlQZEZhT1lmOXRqNlliQlN1YWd2WHBIWmN1a0N6THRBRmRFa3JkUkplSFd6WWZOV0tYdjJOR3VsUXdEQUQyU0s1UWV6by03eUFiMjBJTDZsM3I4eXlzWVpGZFR3d3Vyd2FZTzB6WmtmdGhGUTdITQ\u0026q=http%3A%2F%2Fgoo.gl%2FquusYo\u0026v=n5dR8hY9NRo","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":786,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CP0CEM2rARgBIhMItoD5oMDikgMVydpJBx09RAMkSJrq9LGhvtTLnwHKAQQX9ORh","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqa1A3NVpUTkpQd2t2U05xRjJNYTlTTmF3Uno0Z3xBQ3Jtc0tsVzQ4N1B0S0hrcEVZeTg5MHhLMnIxMXhMQThOR0FyM05fN0ZvVUNNdGhwVHVZbng1LXhPSENONmM3d1B6WXZaZVZadmpWbVRyMGdYaHQxWGVlZnNWRjhjeHNTUGIwNGNncmJxdXEtd3d4X1liUkV1dw\u0026q=http%3A%2F%2Fwww.Rashed.TV%2F\u0026v=n5dR8hY9NRo","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqa1A3NVpUTkpQd2t2U05xRjJNYTlTTmF3Uno0Z3xBQ3Jtc0tsVzQ4N1B0S0hrcEVZeTg5MHhLMnIxMXhMQThOR0FyM05fN0ZvVUNNdGhwVHVZbng1LXhPSENONmM3d1B6WXZaZVZadmpWbVRyMGdYaHQxWGVlZnNWRjhjeHNTUGIwNGNncmJxdXEtd3d4X1liUkV1dw\u0026q=http%3A%2F%2Fwww.Rashed.TV%2F\u0026v=n5dR8hY9NRo","target":"TARG