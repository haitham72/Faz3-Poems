rPalette":{"baseBackground":4280028162,"raisedBackground":4281801225,"additiveBackground":734623045,"textPrimary":4294699744,"textSecondary":4292918697,"invertedBackground":4293108348,"overlayBackground":3426163209},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"Egs3NWhPWnIzdGNfdyDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"1,316,041"},"label":{"simpleText":"عدد المشاهدات"},"accessibilityText":"1,316,041 مشاهدة","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566850885,"textPrimary":4281801225,"textSecondary":4285811764,"invertedBackground":4287579417,"overlayBackground":3426163209},"darkThemeColorPalette":{"baseBackground":4280028162,"raisedBackground":4281801225,"additiveBackground":734623045,"textPrimary":4294699744,"textSecondary":4292918697,"invertedBackground":4293108348,"overlayBackground":3426163209},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2014"},"label":{"simpleText":"22 أكتوبر"},"accessibilityText":"22‏/10‏/2014","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566850885,"textPrimary":4281801225,"textSecondary":4285811764,"invertedBackground":4287579417,"overlayBackground":3426163209},"darkThemeColorPalette":{"baseBackground":4280028162,"raisedBackground":4281801225,"additiveBackground":734623045,"textPrimary":4294699744,"textSecondary":4292918697,"invertedBackground":4293108348,"overlayBackground":3426163209},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBwQ040EGAYiEwjvgIKkwOKSAxUG10kHHb1NFqHKAQScmA1b","commandMetadata":{"webCommandMetadata":{"url":"/@Balqees","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCQd1_s2J6NvI-7YYN6MkIxA","canonicalBaseUrl":"/@Balqees"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/q97iQ_gR_q8VuUCsBpPUmTMY9K5P8bxaow6hmWJXd4SvM4bvBuKqKECl1qsKig6u09faWbPn=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"عرض المزيد"}},"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"attributedDescriptionBodyText":{"content":"Balqees Fathi \u0026 Abu Bakr Salem - AlShear Diwan | بلقيس فتحي و أبو بكر سالم - الشعر ديوان\n\nكلمات: الشيخ حمدان بن محمد بن راشد - فزاع\nألحان: فايز السعيد\n\nكلمات الاغنية \nالشعر ديوان ماضي عربنا والأداه\nألتي كانت توضح لنا عاداتها \nدايمٍ من يكتبه إيتمنّى من قراه\nالتبحّر في القصيدة عبر كلماتها\nبس انا ما قلته اطمع لشهره من وراه\nقلته أداوي جروح البشر واهاتها\nكيف يطمح فيه واحد ذِكِر جَدّه واباه\nإصنعت مكانته من عظم وقفاتها\nليس مثلي من قصيدة ترفع مستواه \nلو من اللولو والمرجان صغت أبياتها \nكم صغير(ن) في العمر وصل للعالم نباه\nوصادم بهامته ناس لها هاماتها\nبالمكارم تسمع اسمه من أفواه الرواه\nوغيره اسمه حسب دخل عقاراتها\nلو عمينا العين و اشلون نكتم كل فاه\nوالعرب أكثر ما فيها عدد رواتها\nوالصديق اللي يتضايق من صديقه شو بلاه\nغرته دنياه يوم كثرت لذاتها\nالصديق من الصديق يتحمله خطاه\nوالأصدقاء مع بعضها حسب نياتها\nوابن آدم كل واحد حسب ما الله عطاه\nسيئآت الناس ماهي مثل حسناتها\nوالدول مع بعضها لو يصير اشتباه \nبتقدم مصلحتها على أزماتها\nكم نصحته والنصيحة من المسلم لأخآه\nوقلت له يا خلها معك وإلا هاتها\nوأنت بعت الود والود ومن باعه شرآه\nوأعرف مشاعر الناس من نظراتها\nالسؤال اللي يراودني على كل اتجاه \nعند مثلك سلعة الطيب كم دفعاتها \nلا تحسب ان كل جافي بكت عيني جفاه \nلي مقاماتي وللناس مقاماتها \nشخص لا من غاب بعده يشتت الإنتباه\nوشخص لا من غاب بنفسك تحس بذاتها\nناس نبكيها لو أنها على قيد الحياة \nوناس ما يأثر علينا خبر وفاتها\n\nإنضموا لقناة بلقيس الرسمية على يوتيوب وشاهدوا أحدث أعمالها:\nhttp://goo.gl/NQVQ2F\n\nتابع بلقيس على: \nhttps://balqeess.lnk.to/Platforms\n\nDigital Distribution: Chabaka\n  / chabaka.music  ","commandRuns":[{"startIndex":1367,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAYiEwjvgIKkwOKSAxUG10kHHb1NFqFI_Oe17-vMk8zvAcoBBJyYDVs=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbkdCSF9jSm8xUDlZR3BJRG5MZnI3c2RISm9kUXxBQ3Jtc0trRXR4NnkyeDdJdjVSZEF6Q1kwZ2VTanVxcTRFM0o4UndqZklkdnV0eEh1NGUwX2JFeTlpS2xUWE5RaWM3RVBkcktzYVFkeS1ZUDJCVlFqeTNYdklIVWtOa3hFVUM2TWZEZ19oSE5EZ0lvZEtHMkZiNA\u0026q=http%3A%2F%2Fgoo.gl%2FNQVQ2F\u0026v=75hOZr3tc_w","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbkdCSF9jSm8xUDlZR3BJRG5MZnI3c2RISm9kUXxBQ3Jtc0trRXR4NnkyeDdJdjVSZEF6Q1kwZ2VTanVxcTRFM0o4UndqZklkdnV0eEh1NGUwX2JFeTlpS2xUWE5RaWM3RVBkcktzYVFkeS1ZUDJCVlFqeTNYdklIVWtOa3hFVUM2TWZEZ19oSE5EZ0lvZEtHMkZiNA\u0026q=http%3A%2F%2Fgoo.gl%2FNQVQ2F\u0026v=75hOZr3tc_w","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":1406,"length":33,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAYiEwjvgIKkwOKSAxUG10kHHb1NFqFI_Oe17-vMk8zvAcoBBJyYDVs=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbXdBX1FMN05NcmxTWjFKRHhobVZRSUFNbVQ3d3xBQ3Jtc0tsYnhpbHpWVWNqX3V3cFRieWViejZ4WVJONWZXdVh0cFdKMmE5UUxmbFBrdVVCc3piV2JlZXJxOWNPT0dsQV92eWJnUEpyZFpfNC1ueS1oVE5uVmY5WUlJYlFBb001Uk01ODJKc2s2NERvQXF5ZFMyQQ\u0026q=https%3A%2F%2Fbalqeess.lnk.to%2FPlatforms\u0026v=75hOZr3tc_w","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbXdBX1FMN05NcmxTWjFKRHhobVZRSUFNbVQ3d3xBQ3Jtc0tsYnhpbHpWVWNqX3V3cFRieWViejZ4WVJONWZXdVh0cFdKMmE5UUxmbFBrdVVCc3piV2JlZXJxOWNPT0dsQV92eWJnUEpyZFpfNC1ueS1oVE5uVmY5WUlJYlFBb001Uk01ODJKc2s2NERvQXF5ZFMyQQ\u0026q