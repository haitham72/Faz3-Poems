 اشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم (فزاع)\nالحان فايز السعيد \n\nاشترك الآن في القناه الرسمية للفنان الوسمي:\nhttps://bit.ly/2UlRaNy\n\nالوسمي -  (حصرياً) | 2022 \n\nAl Wasmy -  (Exclusive) | 2022\n\nتوزيع ديجيتال: شركة قنوات\n\nيا صاحبي ياللي لك العز نوماس\nإن كان عندك علم محرجك إطره\nالشعر ما هو حبر في جوف قرطاس\nو لا بحر تقدر تلاعب بشطره\nالشعر بيت يهز لك كل هوجاس\nو أنا البحر وانته من البحر قطره\nالانسان مشكلته إذا ماله احساس\nالناس في تفكيرها تصير خطره\nخطره وهو يصبح خطر ف اعين الناس\nلذلك الانسان يحتاج فطره\nتحاول توازن أموره بمقياس\nولا يعامل من يعامل ببطره\nالطف كأنك ورد عانقه نسناس\nو احسن كأنك عود فواح عطره\nو لا تفتخـر بالجـاه أو قـوة الـبـاس\nو احفظ من التاريخ حكمه وسطره\nالبيت لو قطره يشيد على ساس\nمع مرور الوقت يختل قطره\nخلد فعل و ادعس على هامة الياس\nالعز مهما طال بيروح وطره","commandRuns":[{"startIndex":133,"length":22,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAUiEwiGs_rvwOKSAxXtmzcIHebiIslI4Z683qrFho7YAcoBBK54jy0=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbGZPUVFBTDc3bVA5VTktRk5OSnVlX2tpcTNBZ3xBQ3Jtc0trMl82LU1rY1BMMnl0REt1XzJTQWNITzItX0ltV3JuZkRsajlhRVFheXI4OEt4ZWc1X1VKdTRNcnQyQWgtSmMxOE1qV0JOUFJ2U2RtcEk5QXI1d1dYZEl0OExYemdrc3NhY3VTRnEtc3dVbnhnMFZyRQ\u0026q=https%3A%2F%2Fbit.ly%2F2UlRaNy\u0026v=2BwaKqvPD2E","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbGZPUVFBTDc3bVA5VTktRk5OSnVlX2tpcTNBZ3xBQ3Jtc0trMl82LU1rY1BMMnl0REt1XzJTQWNITzItX0ltV3JuZkRsajlhRVFheXI4OEt4ZWc1X1VKdTRNcnQyQWgtSmMxOE1qV0JOUFJ2U2RtcEk5QXI1d1dYZEl0OExYemdrc3NhY3VTRnEtc3dVbnhnMFZyRQ\u0026q=https%3A%2F%2Fbit.ly%2F2UlRaNy\u0026v=2BwaKqvPD2E","target":"TARGET_NEW_WINDOW","nofollow":true}}}}],"styleRuns":[{"startIndex":0,"length":133,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294631669},{"key":"