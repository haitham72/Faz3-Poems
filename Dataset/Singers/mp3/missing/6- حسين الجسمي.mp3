cwndbps=1701250\u0026mt=1771398785\u0026oweuc="}}}}},"trackingParams":"CAoQ894BGAAiEwiti_miwOKSAxWKgrEDHV95KdM=","id":"e9bbcd9c-83cf-4663-ac80-bb60bcfae3fa"}},{"endscreenElementRenderer":{"style":"CHANNEL","image":{"thumbnails":[{"url":"https://yt3.ggpht.com/wHJiXzddUXsVsDoFnoNlklKJ8wyN82uOU85zbXhXW9-miwNqFDEhB3oHdf72RRPWEBn4MaZc6w=s250-c-k-c0x00ffffff-no-rj","width":250,"height":250},{"url":"https://yt3.ggpht.com/wHJiXzddUXsVsDoFnoNlklKJ8wyN82uOU85zbXhXW9-miwNqFDEhB3oHdf72RRPWEBn4MaZc6w=s400-c-k-c0x00ffffff-no-rj","width":400,"height":400}]},"icon":{"thumbnails":[{"url":"https://www.gstatic.com/youtube/img/annotations/youtube.png"}]},"left":0.022807017,"width":0.15438597,"top":0.57320875,"aspectRatio":1,"startMs":"385141","endMs":"405141","title":{"accessibility":{"accessibilityData":{"label":"قناة Hussain Al Jassmi | حسين الجسمي"}},"simpleText":"Hussain Al Jassmi | حسين الجسمي"},"metadata":{"simpleText":"صوت بمواصفات عالمية، يحمل هوية أمة، وفنٌ يعانق المحبة والإنسانية بحسٍّ مرهف وأداءٍ استثنائي، وهو أيقونة موسيقية إماراتية وعربية وعالمية، يُعد من أبرز الأصوات وأكثرها تأثيراً، ومصدر فخر واعتزاز فني وإنساني، جعل من موسيقاه مرآةً تنعكس فيها قيم المحبة والتسامح والأصالة. \nوُلد في مدينة خورفكان التابعة لإمارة الشارقة بدولة الإمارات العربية المتحدة، وبدأت مسيرته الفنية عام 1996، منطلقاً من المحلية نحو النجومية العربية والعالمية بخطى ثابتة وإبداع متجدد.\nقدّم أكثر من 2000 عمل فني بين ألبومات وأغانٍ فردية مبهرة وتعاونات مميزة، وبأرقام مذهلة تجاوزت 15  مليار مشاهدة واستماع، تصدّر المنصات الرقمية، ليصبح الفنان العربي الأكثر متابعة وتأثيراً في العالم الرقمي.\nأبدع بأسلوب موسيقي فريد يمزج بين الحداثة وروح التراث، وصاغ بصمته كملحن وعازف بيانو وكاتب أغنيات، تغنّى بكلمات من كبار شعراء العرب، في طليعتهم المغفور له الشيخ زايد بن سلطان آل نهيان، ، وصاحب السمو الشيخ محمد بن زايد آل نهيان، وصاحب السمو الشيخ محمد بن راشد آل مكتوم، وغيرهم من شيوخ وأمراء وشعراء الخليج والوطن العربي.\n"},"callToAction":{"simpleText":"الانتقال إلى القناة"},"dismiss":{"simpleText":"إلغاء"},"endpoint":{"clickTrackingParams":"CAUQ-N4BGAEiEwiti_miwOKSAxWKgrEDHV95KdMyDGl2LWVuZHNjcmVlbkjGmq7TucPch58BygEE9SfbeA==","commandMetadata":{"webCommandMetadata":{"url":"/channel/UC3WI3Ut8Hvc6kzlLcG0IJHw","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC3WI3Ut8Hvc6kzlLcG0IJHw"}},"hovercardButton":{"subscribeButtonRenderer":{"buttonText":{"runs":[{"text":"اشتراك"}]},"subscribed":false,"enabled":true,"type":"FREE","channelId":"UC3WI3Ut8Hvc6kzlLcG0IJHw","showPreferences":false,"subscribedButtonText":{"runs":[{"text":"تم الاشتراك"}]},"unsubscribedButtonText":{"runs":[{"text":"اشتراك"}]},"trackingParams":"CAYQmysiEwiti_miwOKSAxWKgrEDHV95KdMyDGl2LWVuZHNjcmVlbg==","unsubscribeButtonText":{"runs":[{"text":"إلغاء الاشتراك"}]},"serviceEndpoints":[{"clickTrackingParams":"CAYQmysiEwiti_miwOKSAxWKgrEDHV95KdMyDGl2LWVuZHNjcmVlbsoBBPUn23g=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/subscribe"}},"subscribeEndpoint":{"channelIds":["UC3WI3Ut8Hvc6kzlLcG0IJHw"],"params":"EgIIBBgA"}},{"clickTrackingParams":"CAYQmysiEwiti_miwOKSAxWKgrEDHV95KdPKAQT1J9t4","commandMetadata":{"webCommandMetadata":{"sendPost":true}},"signalServiceEndpoint":{"signal":"CLIENT_SIGNAL","actions":[{"clickTrackingParams":"CAYQmysiEwiti_miwOKSAxWKgrEDHV95KdPKAQT1J9t4","openPopupAction":{"popup":{"confirmDialogRenderer":{"trackingParams":"CAcQxjgiEwiti_miwOKSAxWKgrEDHV95KdM=","dialogMessages":[{"runs":[{"text":"إنهاء الاشتراك في قناة \""},{"text":"Hussain Al Jassmi | حسين الجسمي"},{"text":"\"؟"}]}],"confirmButton":{"buttonRenderer":{"style":"STYLE_BLUE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"إلغاء الاشتراك"}]},"serviceEndpoint":{"clickTrackingParams":"CAkQ8FsiEwiti_miwOKSAxWKgrEDHV95KdMyDGl2LWVuZHNjcmVlbsoBBPUn23g=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UC3WI3Ut8Hvc6kzlLcG0IJHw"]