ية"}},{"languageCode":"hmn","languageName":{"simpleText":"الهمونجية"}},{"languageCode":"hi","languageName":{"simpleText":"الهندية"}},{"languageCode":"hu","languageName":{"simpleText":"الهنغارية"}},{"languageCode":"ha","languageName":{"simpleText":"الهوسا"}},{"languageCode":"nl","languageName":{"simpleText":"الهولندية"}},{"languageCode":"war","languageName":{"simpleText":"الواراي"}},{"languageCode":"wo","languageName":{"simpleText":"الولوفية"}},{"languageCode":"cy","languageName":{"simpleText":"الويلزية"}},{"languageCode":"ja","languageName":{"simpleText":"اليابانية"}},{"languageCode":"yi","languageName":{"simpleText":"اليديشية"}},{"languageCode":"yo","languageName":{"simpleText":"اليوروبا"}},{"languageCode":"el","languageName":{"simpleText":"اليونانية"}},{"languageCode":"dz","languageName":{"simpleText":"دزونكا"}},{"languageCode":"qu","languageName":{"simpleText":"كيشوا"}},{"languageCode":"haw","languageName":{"simpleText":"لغة هاواي"}},{"languageCode":"kri","languageName":{"simpleText":"Kri"}}],"defaultAudioTrackIndex":0}},"videoDetails":{"videoId":"4ipBiQSkVxA","title":"الوسمي - جسر الصداقة (فيديو كليب - حصريًا) | 2016","lengthSeconds":"647","keywords":["#selfie","dk hewa","fayez al saeed 2014","Fayez Al Saeed Yensa","Fayez al saeed","Fayez AlSaeed - فايز السعيد","fayez alsaeed","selfie","shorta","video clip fayez al saeed","اطير للمغرب","الامارات","انت عيوني","بانيت","البحرين","دبي","دق هيوه","سيلفي","الشرطة","صاروخ","طرب","العماره","فايز السعيد - Fayez AlSaeed","فايز السعيد \u0026 سلمان حميد","فايز السعيد 2014","فايز السعيد","في دبي","فيديو سيلفي","قطر","قلب للبيع","لبنان","مراكش","مراكشيه","مصر","المغرب","هلو عيني ينسى","Al-'Amara","#سيلفي","fayez al saeed enta ouyouni"],"channelId":"UCymZzEo2d5ZV8G4Y671O1vw","isOwnerViewing":false,"shortDescription":"اشترك الآن في قناة فايز السعيد الرسمية للحصول على أجدد إصداراته الفنية \nhttp://goo.gl/iyOky9\n\nالوسمي - جسر الصداقة (فيديو كليب - حصريًا) | 2016\nAlwasmy - Jisr alsadaqah (Music Video - EXCLUSIVE) | 2016\n \nكلمات : سمو الشيخ حمدان بن محمد بن راشد آل مكتوم (فزاع)\nالحان : سفير الالحان فايز السعيد\nاداء : الوسمي\nإخراج :ياسر الياسري\nتوزيع ديجيتال: شركة قنوات\n\nكلمات الأغنية:\nالضـايق اللي سـاريٍ لـيله ولا حَصَّـل طريق\nتلـعــب به الايّـام بيـن يْـميـنهـا وشْـمالـها\nيا غَـارقٍ بالهَم لا تطـلب نجاتك من غريق\nالصبر مفـتاح الـفرج ، والـناس هـذا حالها\n\nوانا ترى مَتني يشيل مْن الحِمِل ما لا يطيق\nمالي ومـال الـحِـمله اللي كل كـتفٍ شـالها\nوالدلّـه اللي ماتـقهوي ضيفها ، قِل للبريق\nيرسل تعـازي ضـوّها لا فاحت بْفـنجـالها\n\nأيّامنا بين الشهر واليوم ، والباقي سحيق\nالايّام كم يبغى لها ، والناس كم يبغى لها\nقمريّة الأحزان لا غَنَّت على الغصن الدقيق\nما تْعـاتب الـمحزون لو غَنَّت وَلا غَنَّى لها\n\nيا ناس وش حَل الرفيق اللي يعاتب له رفيق\nلا حَدِّتـه الايّـام ، والدنـيا عـلى منـوالها\nلا تحسب ان اللي تحبَّه لا جَرَحته ما يضيق\nلو يسـتر جْـروحه عـليك وعِـلِّـتـه ما قالــها\n\nيضيق لكن مَبْسمه ضَحَّاك وِحْجَاجه طليق\nلان الصَّداقه كنز ، والحَسْـنَه بِعَشْـر امثالـها\nوالحقد في قلوب الرجال اهْل الوفا ماهو يليق\nقـلـوبـها تبقى نـظـيفه .. لـو تـغَـيَّـر حـالـها\n\nوانا لو ابني للصداقه جسر لعيـون الصـديق\nالـناس من كثر الزعل ، فال الله وْلا فالــها\nالعـذر مايكفي من التـقدير ، والصدَّه تعـيق\nالوصـل من بيـن الـقـلـوب اللـي تـمـد حْـبالـها\n\nوالالماس سِعره فوق سِعرك يالذهب لو لك بريق\nسِـعره لـحَاله .. والذهب تسـعـيرته بلْـحَالـها\nواهْل الجواهر يفرقون الكـهرمان مْن العقـيق\nلو تخـلـط الثـنتيـن بنـتٍ فـي طَـرَف سلسالها\n\nنَصبر على قَرص النحَل حتى نوصِّل للرحيق\nواهل الهـوى يمسـح خطـاياها لـذيذ وْصـالـها\nوالـناس لاجـل آمالـها تحـتاج للفـهم الدقـيق\nواللي ما تمـلك فَـهـم تخسـر نفـسـها وآمـالـها\n\nجْبال الارض الشامخه يا منكر الـمجد العريق\nهـامـاتنا من كـبر هـيبتنا ، تطـول جْـبالـها\nجديـدنا مستـقـبلٍ زاهـر ، وماضـينا عتـيق\nمسـيرة الـتاريخ يـبقـى مـجـدنا فـي بـالـها\n\nلو ان حَـضارتنا قصيدة شـاعرٍ فكـره عمـيق\nما كان غير محـمد الـمكـتــــوم صـاغ امثـالها\nــــــــــــــــــــــ .\nOfficial Website: http://www.fayez-alsaeed.com\nOfficial Google+: https://goo.gl/B4244h \nOfficial Twitter: https://twitter.com/FayezOfficial \nOfficial Instagram: https://www.instagram.com/fayez_alsaeed/ \nOfficial Facebook: https://www.facebook.com/FayezOfficial \nOfficial Youtube: https://youtube.com/FayezAlSaeedSound","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/4ipBiQSkVxA/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLAk4dQITqM12HXIiYDhBF7NasF7tQ","width":168,"height":94},{"url":"https://i.ytimg.com/vi/4ipBiQSkVxA/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLCbIxHjmWn3whM4lQgtLQtsN6mEHw","width":196,"height":110},{"url":"https://i.ytimg.com/vi/4ipBiQSkVxA/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLDFW5GZReykea8swuNGABMvqp08yQ","width":246,"height":138},{"url":"https://i.ytimg.com/vi/4ipBiQSkVxA/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLCAw1MZpcBtG3C99gLuAqAYg542hA","width":336,"height":188},{"url":"https://i.ytimg.com/vi/4ipBiQSkVxA/maxresdefault.jpg","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"86105","author":"Fayez AlSaeed | فايز السعيد","isPrivate":false,"isUnpluggedCorpus":false,"isLiveContent":false},"annotations":[{"playerAnnotationsExpandedRenderer":{"featuredChannel":{"startTimeMs":"0","endTimeMs":"627000","watermark":{"thumbnails":[{"url":"https://i.ytimg.com/an/ymZzEo2d5ZV8G4Y671O1vw/featured_channel.jpg?v=6387395d","width":40,"height":40}]},"trackingParams":"CBQQ8zciEwit78SkwOKSAxVBwUkHHTQyNCI=","navigationEndpoint":{"clickTrackingParams":"CBQQ8zciEwit78SkwOKSAxVBwUkHHTQyNCIyAml2ygEEJ01zSw==","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCymZzEo2d5ZV8G4Y671O1vw","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCymZzEo2d5ZV8G4Y671O1vw"}},"channelName":"Fayez AlSaeed | فايز السعيد","subscribeButton":{"subscribeButtonRenderer":{"buttonText":{"runs":[{"