:\nhttps://www.youtube.com/@alafasy?sub_confirmation=1\n\nاخترنا لك : 50 تلاوة مميزة للقارئ مشاري راشد العفاسي\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN\u0026feature=shared\n\nمصحف قديم الشيخ مشاري راشد العفاسي\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSqc3yePg5cstFT3lpStFUb1\u0026feature=shared\n\nمصحف كاليفورنيا من صلاة التراويح \nhttps://youtube.com/playlist?list=PL2hoGhz2jBSr0F3k9hIYqsllrqKlMLn1V\u0026feature=shared\n\nالمصحف المرتل الأول الذي سُجل في الكويت ومصر  عام 2003م 1424هـ\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSpGpWPEQv5LjwVlTMYXXxnC\u0026feature=shared\n\nمصحف القرآءات العشر الجديد \nhttps://youtube.com/playlist?list=PL2hoGhz2jBSroDP_SDhYNMCOAkzHozQZo\u0026feature=shared\n\nجميع أناشيد القارئ مشاري راشد العفاسي\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSq-5dulEtVsDxIEBn1BJsrS\u0026feature=shared\n\nالأدعية وأذكار الصباح والمساء والرقية الشرعية\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSqosLJN5ECy3KsgT_Pu8kNX\u0026feature=shared\n\nمن أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم \nألحان فايز السعيد\nتوزيع مصطفى قاسم واحمد سعيد\nاداء وهندسة صوتية \nمشاري راشد العفاسي\n\nالله خلق لي نفس تسـمو على البوح\n\nماهـيب لا ضاقـت من الهـم باحـت\n\nعلى كثر ما شفت ضيقات وجروح\n\nلا الوجه متغـيّر ولا العـين صاحت\n\nأبـشـّرك .. بـشـارة الـروح للـروح\n\nتـبي تطـيّحـني اللـيـالي و طـاحـت\n\nهـذا أنـا والـوجـه باسـم ومـشـروح\n\nوجهٍ بروقـه لمعـظم الناس لاحـت\n\nكم محزن ٍ بنى على شـوفه صروح\n\nوكم نفس من طارف عطاه استراحت\n\nألله وهـبـنا عـز و امجـاد و طمـوح\n\nوذكـر ٍعـلى جـدران الايـّـام ناحِـت\n\nهذي مراجل ماهي بضحك ومزوح\n\nماهي شموع لا ضوا الصبح ساحت\n\nالصـفح خصله والفخر ماله سطوح\n\nوالحزن لا سيطر على الروح ناحت\n\nبعض الجروح تجي لك شوي وتروح\n\nوبعض الجروح ان جات ماعاد راحت","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/XvgzeRmcaig/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLANem_6q3GK1Wj_cShnroiBWos4gw","width":168,"height":94},{"url":"https://i.ytimg.com/vi/XvgzeRmcaig/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLBi8pH5mwGAmYaoJvW4UGGJXBAi_w","width":196,"height":110},{"url":"https://i.ytimg.com/vi/XvgzeRmcaig/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLCafdvI01ysXco0Yhnzx4SGqMiPHw","width":246,"height":138},{"url":"https://i.ytimg.com/vi/XvgzeRmcaig/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLDUmFaE6THBWm_uy2v0U_lLCFI4vg","width":336,"height":188},{"url":"https://i.ytimg.com/vi/XvgzeRmcaig/maxresdefault.jpg","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"832429","author":"Alafasy","isPrivate":false,"isUnpluggedCorpus":false,"isLiveContent":false},"annotations":[{"playerAnnotationsExpandedRenderer":{"featuredChannel":{"startTimeMs":"0","endTimeMs":"338000","watermark":{"thumbnails":[{"url":"https://i.ytimg.com/an/mMcOjsVehVlEOteyrhjI2Q/featured_channel.jpg?v=58adc709","width":34,"height":45}]},"trackingParams":"CBMQ8zciEwitgvTwwOKSAxVCRE8EHaz7BSs=","navigationEndpoint":{"clickTrackingParams":"CBMQ8zciEwitgvTwwOKSAxVCRE8EHaz7BSsyAml2ygEE44YPaA==","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCmMcOjsVehVlEOteyrhjI2Q","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCmMcOjsVehVlEOteyrhjI2Q"}},"channelName":"Alafasy","subscribeButton":{"subscribeButtonRenderer":{"buttonText":{"runs":[{"text":"اشتراك"}]},"subscribed":false,"enabled":true,"type":"FREE","channelId":"UCmMcOjsVehVlEOteyrhjI2Q","showPreferences":false,"subscribedButtonText":{"runs":[{"text":"تم الاشتراك"}]},"unsubscribedButtonText":{"runs":[{"text":"اشتراك"}]},"trackingParams":"CBQQmysiEwitgvTwwOKSAxVCRE8EHaz7BSsyAml2","unsubscribeButtonText":{"runs":[{"text":"إلغاء الاشتراك"}]},"serviceEndpoints":[{"clickTrackingParams":"CBQQmysiEwitgvTwwOKSAxVCRE8EHaz7BSsyAml2ygEE44YPaA==","commandMetadata":{"webCommandMetadata":{"se