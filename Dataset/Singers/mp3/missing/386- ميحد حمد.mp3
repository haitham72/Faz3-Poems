omWatchLaterCommand":{"clickTrackingParams":"CAAQu2kiEwj086fvwOKSAxUFGwYAHelRNW_KAQT4NcGV","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/browse/edit_playlist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"action":"ACTION_REMOVE_VIDEO_BY_VIDEO_ID","removedVideoId":"Z34o6SLRqD4"}]}}}}},"storyboards":{"playerStoryboardSpecRenderer":{"spec":"https://i.ytimg.com/sb/Z34o6SLRqD4/storyboard3_L$L/$N.jpg?sqp=-oaymwGhAUg48quKqQOYAYgBAZUBAAAEQpgBMqABPKgBBLIBQBANDBAVHyYtDg4PEhcrLCkPDhAVHyoyKQ8RFBgmPTgtERQeKjFLRzYVHCkuOUdNPyUuNz1HUlFFM0BCQ0xERkO6AUARERUjRENDQxETFi9DQ0NDFRYpQ0NDQ0MjL0NDQ0NDQ0RDQ0NDQ0JCQ0NDQ0NCQkJDQ0NDQkJCQkNDQ0JCQkJCovOX_wMGCKPm4ZQG|48#27#100#10#10#0#default#rs$AOn4CLCmq8VZEW8QUVDxvbd_AHlkP7Z3Sw|80#45#122#10#10#5000#M$M#rs$AOn4CLAHtdvqJZFazF6FM50ybEz4VPvQKQ|160#90#122#5#5#5000#M$M#rs$AOn4CLCt21i_y-IdFf_hdq4Yh4xpRyYrTQ","recommendedLevel":2,"highResolutionRecommendedLevel":2}},"microformat":{"playerMicroformatRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/Z34o6SLRqD4/maxresdefault.jpg?sqp=-oaymwEmCIAKENAF8quKqQMa8AEB-AH-CYAC0AWKAgwIABABGGUgTihGMA8=\u0026rs=AOn4CLAQZRA9Xqinhxzud-MfPopbK6GTVg","width":1280,"height":720}]},"embed":{"iframeUrl":"https://www.youtube.com/embed/Z34o6SLRqD4","width":1280,"height":720},"title":{"simpleText":"ميحد حمد - أنا أنا - Mehad Hamad - Ana Ana"},"description":{"simpleText":"اشترك في قناة \" مبادرة حمدان بن محمد للابداع الأدبي\" الرسمية:\nhttps://goo.gl/QieNFb\n \nميحد حمد - أنا أنا \nMehad Hamad - Ana Ana\n\nمن أشعار : الشيخ حمدان بن محمد بن راشد آل مكتوم( فزاع )\nالحان : فايز السعيد\n\n\n‎الحـب لـو مايَـغـرقـك شـوق وَاشْـجـان \n‎تـعِــن مـن تـلــقــاء نـفـســك خـيـــوله \n‎وتــأسِّـسـه تـأسـيـس دولــه بْـعـنـــوان \n‎تعـيـش حـاكِـم حـب والـشــوق دولــــه \n‎تـْــبَـدّدَت كـل الـمـشــاعـر عـلى شـــان \n‎لان الـحـيـاه بْـلا مـشــاعـر خـجــولـــه \n‎أنـا .. أنـا لو عـشت فـي كـل الازمــان \n‎شـخـصـيِّـتي لي ..والـغــلا للّـي هـو لـه \n‎إلى هـنا يـاللـي تـقــول الـوعـــد حــان \n‎تـعـال قـل لي والـفـيـلـم وش فـصـولـه \n‎مْـجـامـَــل وْآهـــات وجْـــروح واحــزان \n‎وانــا مـرَشـَّــــحْـكــم لــدور الـبـطــولـه \n‎يمـكـن أجـامِـل نــاس أحـيـان واحْـيـان \n‎إلا مـصـيـري لـيه اقـول انـسـجـوا لـه \n‎إن قـلـتــوا اسـتـبـداد ... رَدّيـت والآن \n‎تـذكـَّـروا أحـلـى فـصــول الـطــفـــوله \n‎عـطــيْـتـكـم منـهـا لآلــيء ومـرجـــان \n‎والـيـوم خـلـّــونـي بْـــدور الـرجــــولـه \n\n‎ترى الـغـلا زوده مـع الـوقـت نـقـصـان \n‎إلى مــن يــحـبِّـــــك تـغــيَّــر مـيــــولـه \n\n‎هذا كـلام قـلـوب يـنطـق به انـســـان \n‎ويْـبـيـن فـي وجـهـه قـبـل ما يــقـولــه \n\n‎ماهـو كـلام انـسـان يـنطـق به لسـان \n‎إحـسـاسـه بْـمـعـنـاه مـاهـو بْـحــولـه \n\n‎تحسدني اصْحابي على جاه سلطان \n‎وتـحـسـدني اعـدائـي على ما أنـولـه \n\n‎والـمؤمـن الـصَّادق بفـطرته برهـان \n‎لـو ثـوبـه مْرقـَّع وحـفـيَـت رجــولـه \n\n‎حَـكـَّـايـة الـدنـيـا يـزيــدونـه ايْـمـان \n‎والفـاسـق ايْـمـانـه يقِـل ان حـكـوا له \n\n‎وانـا قـبـل يومـيـن قـلت الأنــا شــان \n‎وجْـه الـزمـان اللي ذبحـني فـضـوله \n\n‎قال العـقـل من قـلب يدفـعه وجْدان \n‎يـكـره مـظـاهـر للـحـيـاه الـعــجــوله \n\n‎ما كل شيّ إيْدك تطوله يا(حمدان) \n‎إحْـســاسـك يْـوافـق بأنـّـك تـطــوله \n\n‎وانا بَشَـر لي قلـب واحساس واعْيان \n‎وعـندي على التمـيـيز قدره مـهـوله \n\n‎إنسـان .. يمـلـكني مَعَ الوقت شيئان \n‎ربّـي وْديـنـي مـخـلّـده في رسـولـه \n\n‎لـذلك الإنـســــان يـا نــــاس لـو كــان \n‎بْـلا جَـــرءَة رأي .. تـثـقــل حـمـــولـه \n\n‎من ينـتـظـر فرصــه من فـلان وفـلان \n‎تلـقى مـقـام الـمجـد صعـبٍ وصوله \n\n#ميحد_حمد \n#ميحد_حمد_قديم \n#أنا_أنا\n\nتوزيع ديجيتال: شركة قنوات\nــــــــــــ \nOfficial Twitter: https://twitter.com/mubadara\nOfficial Instagram: https://instagram.com/mubadara/\nOfficial Facebook: https://goo.gl/nOU7y2\nOfficial Google+: https://goo.gl/1XXMN3\nOfficial Youtube: https://goo.gl/mifdwF"},"lengthSeconds":"601","ownerProfileUrl":"http://www.youtube.com/@MubadartHamdanBinMahmmad","externalChannelId":"UCuSEtWLpHvMFDXhyuaQM01A","isFamilySafe":true,"availableCountries":["AD","AE","AF","AG","AI","