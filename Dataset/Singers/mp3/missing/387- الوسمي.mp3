E_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCsja3yhqEf6ju5Ji9WS6SsA","canonicalBaseUrl":"/@alwasmy"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ScjPzStQM8JmZSiPn7mSmnl1BHryCkNnEDPLbyS48x41AqXIizf-qSLrz_dETY7ZLFYXiegCiMA=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"عرض المزيد"}},"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"attributedDescriptionBodyText":{"content":"رسالة خاصة \nمن اشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم (فزاع)\nالحان فايز السعيد \n\nاشترك الآن في القناه الرسمية للفنان الوسمي:\nhttps://bit.ly/2UlRaNy\n\nالوسمي -  (حصرياً) | 2022 \n\nAl Wasmy -  (Exclusive) | 2022\n\nتوزيع ديجيتال: شركة قنوات\n\nيا صاحبي ياللي لك العز نوماس\nإن كان عندك علم محرجك إطره\nالشعر ما هو حبر في جوف قرطاس\nو لا بحر تقدر تلاعب بشطره\nالشعر بيت يهز لك كل هوجاس\nو أنا البحر وانته من البحر قطره\nالانسان مشكلته إذا ماله احساس\nالناس في تفكيرها تصير خطره\nخطره وهو يصبح خطر ف اعين الناس\nلذلك الانسان يحتاج فطره\nتحاول توازن أموره بمقياس\nولا يعامل من يعامل ببطره\nالطف كأنك ورد عانقه نسناس\nو احسن كأنك عود فواح عطره\nو لا تفتخـر بالجـاه أو قـوة الـبـاس\nو احفظ من التاريخ حكمه وسطره\nالبيت لو قطره يشيد على ساس\nمع مرور الوقت يختل قطره\nخلد فعل و ادعس على هامة الياس\nالعز مهما طال بيروح وطره","commandRuns":[{"startIndex":133,"length":22,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAUiEwiGs_rvwOKSAxXtmzcIHebiIslI4Z683qrFho7YAcoBBK54jy0=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbDhZclpMM254TlN5ZUpqYzBpTERsME9oMERCQXxBQ3Jtc0tsY0NtdVhHNXExeTRLUmRkb241eEdxei1BYm9FbWFibnNZeEdSSllrN0hKdnc2Sm1PNXZEUVpuOUh4LWZRWnprRUk3dE40V1prRGVUQXVlNTVGVlVZaDc3d1FzNlNZX2lRMHFDSVcwZ3piSG9Sd3VGQQ\u0026q=https%3A%2F%2Fbit.ly%2F2UlRaNy\u0026v=2BwaKqvPD2E","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpo