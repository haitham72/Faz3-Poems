غرك يجيـه \nلو كان رمشك ينهب كـان انهـب من كل عاقل شاف رمشك او سفيه \nلا ترتهب ما فيـه واحـد يرتهـب من واحـد يحبـه و خفاقـه يبيـه \nانا في مهب الريح الا انت افـمهب شوقٍ سكن قلبي و قلبي محتويـه \nذهب معك قلبي يا ليته مـا ذهـب لاقلت عوّد قال انا با مـوت فيـه \nتدري وش يخلي جروحي تلتهـب اني اخلـي شـي وانـا مشتهيـه \nانت ذهب من دون ما تلبس ذهـب وش له تروح السوق و اتدور عليه \nـــــــــــــ\nOfficial Website: http://www.hussainaljassmi.com\nOfficial Twitter:   / 7sainaljassmi   \nOfficial Instagram:   / 7sainaljassmi   \nOfficial Facebook:   / hussainaljassmi  \nOfficial Google+: https://google.com/+HussainAlJassmi\nOfficial Youtube:    / hussainaljassmi   Official SoundCloud:   / officialhussai.  . . .\nOfficial Website: http://www.hussainaljassmi.com\nOfficial iTunes: http://apple.co/1UcsKU4\nOfficial iTunes Connect: https://itun.es/eg/EsJf0\nOfficial Twitter:   / 7sainaljassmi   \nOfficial Instagram:   / 7sainaljassmi   \nOfficial Facebook:   / hussainaljassmi  \nOfficial Google+: https://plus.google.com/+HussainAlJassmi\nOfficial Youtube:    / hussainaljassmi   \nOfficial SoundCloud:   / hussainaljassmi  ","commandRuns":[{"startIndex":28,"length":23,"onTap":{"innertubeCommand":{"clickTrackingParams":"CJwDEM2rARgBIhMI_Iz5osDikgMVo5E3CB2roQHGSMaartO5w9yHnwHKAQT1J9t4","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbEJ1Qjg0OE5iUHN0S20tS1JhU0M2MXEwZ01rUXxBQ3Jtc0tsRnVVcU1wSVdOVEFSZ2FTcEYwNzUzTDVtUXlEaVg1R3N6YlllT3NNbWgyUHZSY3IzRXFRXzBqaWlaM2k1ODhaUmdWZHYwcmxFaWs4ME5PQVFXRmpVOXZvdnUxN1Q1RXZGWllqVjNkSmt5NnRCQmw3aw\u0026q=http%3A%2F%2Fapple.co%2F1yqdh9I\u0026v=nw9yG5prjUY","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbEJ1Qjg0OE5iUHN0S20tS1JhU0M2MXEwZ01rUXxBQ3Jtc0tsRnVVcU1wSVdOVEFSZ2FTcEYwNzUzTDVtUXlEaVg1R3N6YlllT3NNbWgyUHZSY3IzRXFRXzBqaWlaM2k1ODhaUmdWZHYwcmxFaWs4ME5PQVFXRmpVOXZvdnUx