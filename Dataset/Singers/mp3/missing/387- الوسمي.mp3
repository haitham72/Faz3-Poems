hMIhrP678DikgMV7Zs3CB3m4iLJ"}},"showMoreText":{"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"trackingParams":"CIcCEM2rARgBIhMIhrP678DikgMV7Zs3CB3m4iLJ","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CIcCEM2rARgBIhMIhrP678DikgMV7Zs3CB3m4iLJygEErniPLQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CIcCEM2rARgBIhMIhrP678DikgMV7Zs3CB3m4iLJygEErniPLQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CIcCEM2rARgBIhMIhrP678DikgMV7Zs3CB3m4iLJygEErniPLQ==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CIcCEM2rARgBIhMIhrP678DikgMV7Zs3CB3m4iLJygEErniPLQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"رسالة خاصة \nمن اشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم (فزاع)\nالحان فايز السعيد \n\nاشترك الآن في القناه الرسمية للفنان الوسمي:\nhttps://bit.ly/2UlRaNy\n\nالوسمي -  (حصرياً) | 2022 \n\nAl Wasmy -  (Exclusive) | 2022\n\nتوزيع ديجيتال: شركة قنوات\n\nيا صاحبي ياللي لك العز نوماس\nإن كان عندك علم محرجك إطره\nالشعر ما هو حبر في جوف قرطاس\nو لا بحر تقدر تلاعب بشطره\nالشعر بيت يهز لك كل هوجاس\nو أنا البحر وانته من البحر قطره\nالانسان مشكلته إذا ماله احساس\nالناس في تفكيرها تصير خطره\nخطره وهو يصبح خطر ف اعين الناس\nلذلك الانسان يحتاج فطره\nتحاول توازن أموره بمقياس\nولا يعامل من يعامل ببطره\nالطف كأنك ورد عانقه نسناس\nو احسن كأنك عود فواح عطره\nو لا تفتخـر بالجـاه أو قـوة الـبـاس\nو احفظ من التاريخ حكمه وسطره\nالبيت لو قطره يشيد على ساس\nمع مرور الوقت يختل قطره\nخلد فعل و ادعس على هامة الياس\nالعز مهما طال بيروح وطره","commandRuns":[{"startIndex":133,"length":22,"onTap":{"innertubeCommand":{"clickTrackingParams":"CIcCEM2rARgBIhMIhrP678DikgMV7Zs