nPopupAction":{"popup":{"confirmDialogRenderer":{"trackingParams":"CIMCEMY4IhMI1de7ocDikgMV1M1JBx08xSO3","dialogMessages":[{"runs":[{"text":"إنهاء الاشتراك في قناة \""},{"text":"Asma Lmnawar | أسما لمنور"},{"text":"\"؟"}]}],"confirmButton":{"buttonRenderer":{"style":"STYLE_BLUE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"إلغاء الاشتراك"}]},"serviceEndpoint":{"clickTrackingParams":"CIUCEPBbIhMI1de7ocDikgMV1M1JBx08xSO3KPgdMgV3YXRjaMoBBJF8d4w=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UCSeCHtLvsdwTKtIoGgOroHg"],"params":"CgIIAxILZzQzbWJOR3hpU2sYAA%3D%3D"}},"accessibility":{"label":"إلغاء الاشتراك"},"trackingParams":"CIUCEPBbIhMI1de7ocDikgMV1M1JBx08xSO3"}},"cancelButton":{"buttonRenderer":{"style":"STYLE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"إلغاء"}]},"accessibility":{"label":"إلغاء"},"trackingParams":"CIQCEPBbIhMI1de7ocDikgMV1M1JBx08xSO3"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CIECEM2rARgBIhMI1de7ocDikgMV1M1JBx08xSO3"}},"showMoreText":{"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"trackingParams":"CIECEM2rARgBIhMI1de7ocDikgMV1M1JBx08xSO3","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CIECEM2rARgBIhMI1de7ocDikgMV1M1JBx08xSO3ygEEkXx3jA==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CIECEM2rARgBIhMI1de7ocDikgMV1M1JBx08xSO3ygEEkXx3jA==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CIECEM2rARgBIhMI1de7ocDikgMV1M1JBx08xSO3ygEEkXx3jA==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CIECEM2rARgBIhMI1de7ocDikgMV1M1JBx08xSO3ygEEkXx3jA==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"شاهد كليب يديرها الحب من هنا :    • Asma Lmnawar ... Ydirha Lhob - Video Clip ...  \n\nلتنزيل \"ثلات مرات\" من iTunes:\nhttp://apple.co/1WSxUT7\n\nإشترك في القناة الرسمية لأسما لمنور:\nhttp://bit.ly/AsmaLmnawarYT\n\nأسما لمنور و حسين الجسمي - ثلات مرات (حصرياً) مع الكلمات | 2009\nAsma Lmnawar \u0026 Hussain Al Jassmi - Talat Marat (EXCLUSIVE Lyric Clip) | 2009\n\nكلمات: سمو الشيخ حمدان بن محمد بن راشد آل مكتوم - فزاع\nألحان: فايز السعيد\n\nتوزيع ديجيتال: شركة قنوات\n\nكلمات الأغنية:\nثلاث مرات وانت تدور فراقي وثلاث مرات وانا اقول لا ترحل\nالظاهر ان الغلا ما عاد له باقي بين وبينك اشوف الوضع مستفحل\nعشرة زمن تجبر المشتاق يشتاقي سحرتها بالهجر والوصل ما يسحر\nعليك صابر وهذي قيمة اخلاقي لان ارض الوفا دون الوفا تمحل\nلانك الغالي اللي حرك اشواقي بمكحلات العيون اللي بلا مكحل\nبالرقه انت الارق وذوقك الراقي وبين الخصور النواحل خصرك الانحل\nوقلوب عشاقك اللي كثر عشاقي عيونهم نحل لان شفاتك المنحل\nاصعب سؤال بحياتي يا العاشق الشاقي اللي طرحته عليك وما لقيت الحل\nوشلون ترحل وحبك وسط الاعماقي وانا نويت الرحيل وما قدرت ارحل \nـــــــــــــ\nتابع أسما لمنور:\nLike on Facebook:   / asmalmnawarpage  \nFollow on Instagram:   / asmalmnawar  \nFollow on Twitter:   / asmalmnawar  \nAdd on SnapChat:   / asmalmnawar1  \nFollow on Google+: https://plus.google.com/+AsmaLmnawar\nOfficial iTunes: http://bit.ly/AsmaLmnawariTunes\nOfficial YouTube: http://bit.ly/AsmaLmnawarYT","commandRuns":[{"startIndex":31,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CIECEM2rARgBIhMI1de7ocDikgMV1M1JBx08xSO3ygEEkXx3jA==","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=_6ylCkxPdF4","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"_6ylCkxPdF4","startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonC