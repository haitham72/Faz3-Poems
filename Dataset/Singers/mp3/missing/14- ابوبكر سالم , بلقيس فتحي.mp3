RunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4282296063},{"key":"USER_INTERFACE_THEME_LIGHT","value":4278607828}]}},"fontFamilyName":"Roboto"},{"startIndex":1439,"length":32,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"},{"startIndex":1471,"length":19,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}}}],"attachmentRuns":[{"startIndex":1472,"length":0,"element":{"type":{"imageType":{"image":{"sources":[{"url":"https://www.gstatic.com/youtube/img/watch/social_media/instagram_1x.png"}]}}},"properties":{"layoutProperties":{"height":{"value":14,"unit":"DIMENSION_UNIT_POINT"},"width":{"value":14,"unit":"DIMENSION_UNIT_POINT"},"margin":{"top":{"value":0.5,"unit":"DIMENSION_UNIT_POINT"}}}}},"alignment":"ALIGNMENT_VERTICAL_CENTER"}],"decorationRuns":[{"textDecorator":{"highlightTextDecorator":{"startIndex":1471,"length":19,"backgroundCornerRadius":8,"bottomPadding":1,"highlightTextDecoratorExtensions":{"highlightTextDecoratorColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":452984831},{"key":"USER_INTERFACE_THEME_LIGHT","value":218103808}]}}}}}]},"headerRuns":[{"startIndex":0,"length":1367,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1367,"length":20,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1387,"length":19,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1406,"length":33,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1439,"length":32,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1471,"length":19,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566850885,"textPrimary":4281801225,"textSecondary":4285811764,"invertedBackground":4287579417,"overlayBackground":3426163209},"darkThemeColorPalette":{"baseBackground":4280028162,"raisedBackground":4281801225,"additiveBackground":734623045,"textPrimary":4294699744,"textSecondary":4292918697,"invertedBackground":4293108348,"overlayBackground":3426163209},"colorSampledDescriptionBodyText":{"content":"Balqees Fathi \u0026 Abu Bakr Salem - AlShear Diwan | بلقيس فتحي و أبو بكر سالم - الشعر ديوان\n\nكلمات: الشيخ حمدان بن محمد بن راشد - فزاع\nألحان: فايز السعيد\n\nكلمات الاغنية \nالشعر ديوان ماضي عربنا والأداه\nألتي كانت توضح لنا عاداتها \nدايمٍ من يكتبه إيتمنّى من قراه\nالتبحّر في القصيدة عبر كلماتها\nبس انا ما قلته اطمع لشهره من وراه\nقلته أداوي جروح البشر واهاتها\nكيف يطمح فيه واحد ذِكِر جَدّه واباه\nإصنعت مكانته من عظم وقفاتها\nليس مثلي من قصيدة ترفع مستواه \nلو من اللولو والمرجان صغت أبياتها \nكم صغير(ن) في العمر وصل للعالم نباه\nوصادم بهامته ناس لها هاماتها\nبالمكارم تسمع اسمه من أفواه الرواه\nوغيره اسمه حسب دخل عقاراتها\nلو عمينا العين و اشلون نكتم كل فاه\nوالعرب أكثر ما فيها عدد رواتها\nوالصديق اللي يتضايق من صديقه شو بلاه\nغرته دنياه يوم كثرت لذاتها\nالصديق من الصديق يتحمله خطاه\nوالأصدقاء مع بعضها حسب نياتها\nوابن آدم كل واحد حسب ما الله عطاه\nسيئآت الناس ماهي مثل حسناتها\nوالدول مع بعضها لو يصير اشتباه \nبتقدم مصلحتها على أزماتها\nكم نصحته والنصيحة من المسلم لأخآه\nوقلت له يا خلها معك وإلا هاتها\nوأنت بعت الود والود ومن باعه شرآه\nوأعرف مشاعر الناس من نظراتها\nالسؤال اللي يراودني على كل اتجاه \nعند مثلك سلعة الطيب كم دفعاتها \nلا تحسب ان كل جافي بكت عيني جفاه \nلي مقاماتي وللناس مقاماتها \nشخص لا من غاب بعده يشتت الإنتباه\nوشخص لا من غاب بنفسك تحس بذاتها\nناس نبكيها لو أنها على قيد الحياة \nوناس ما يأثر علينا خبر وفاتها\n\nإنضموا لقناة بلقيس الرسمية على يوتيوب وشاهدوا أحدث أعمالها:\nhttp://goo.gl/NQVQ2F\n\nتابع بلقيس على: \nhttps://balqeess.lnk.to/Platforms\n\nDigital Distribution: Chabaka\n  / chabaka.music  ","commandRuns":[{"startIndex":1367,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAYiEwjvgIKkwOKSAxUG10kHHb1NFqFI_Oe17-vMk8zvAcoBBJyYDVs=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbGVDMmF5N3E0THN4RXdQWGJSU2lyQ1dhSHVjQXxBQ3Jtc0ttZEpjZE5rLVZLS1VBMVQxbGJtTVBaYndwbHNuRm1tRkZBNlBXVmNfUWRvMFJkalJrWkFjWWFULVk1XzRQSmxYV1N6WVRUMlJCRGJVQTROcUhOYUpoajlJOUNlMzNNUUxtMmt1MXRhV0tnLVdQSFluSQ\u0026q=http%3A%2F%2Fgoo.gl%2FNQVQ2F\u0026v=75hOZr3tc_w","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbGVDMmF5N3E0THN4RXdQWGJSU2lyQ1dhSHVjQXxBQ3Jtc0ttZEpjZE5rLVZLS1VBMVQxbGJtTVBaYndwbHNuRm1tRkZBNlBXVmNfUWRvMFJkalJrWkFjWWFULVk1XzRQSmxYV1N6WVRUMlJCRGJVQTROcUhOYUpoajlJOUNlMzNNUUxtMmt1MXRhV0tnLVdQSFluSQ\u0026q=http%3A%2F%2Fgoo.gl%2FNQVQ2F\u0026v=75hOZr3tc_w","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":1406,"length":33,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAYiEwjvgIKkwOKSAxUG10kHHb1NFqFI_Oe17-vMk8zvAcoBBJyYDVs=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbDE3cU5LdGg1cVAwYXc5bWFfWmxXdlJWZUptUXxBQ3Jtc0ttZ29LZkVUVW9BZXZEa0JRVUVtNjVzSWtiMFVOMmppWlVFWWZiOVJCT3dRUENIVXJQTG80MFZ3OTBWclI4VElGNElhWnpOVmRJWUdzYkxKWXpxRlU5QUVyM0JKMWRSV0hDWGJDNnAwWl9Hdm5wQ0RBWQ\u0026q=https%3A%2F%2Fbalqeess.lnk.to%2FPlatforms\u0026v=75hOZr3tc_w","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbDE3cU5LdGg1cVAwYXc5bWFfWmxXdlJWZUptUXxBQ3Jtc0ttZ29LZkVUVW9BZXZEa0JRVUVtNjVzSWtiMFVOMmppWlVFWWZiOVJCT3dRUENIVXJQTG80MFZ3OTBWclI4VElGNElhWnpOVmRJWUdzYkxKWXpxRlU5QUVyM