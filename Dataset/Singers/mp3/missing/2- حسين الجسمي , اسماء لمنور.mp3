D"},{"startIndex":1248,"length":31,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1279,"length":19,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1298,"length":27,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293980927,"raisedBackground":4293980927,"additiveBackground":558193609,"textPrimary":4278849846,"textSecondary":4282008174,"invertedBackground":4279839631,"overlayBackground":3423211830},"darkThemeColorPalette":{"baseBackground":4278322716,"raisedBackground":4278849846,"additiveBackground":725965769,"textPrimary":4292928762,"textSecondary":4289508317,"invertedBackground":4286352611,"overlayBackground":3423211830},"colorSampledDescriptionBodyText":{"content":"شاهد كليب يديرها الحب من هنا :    • Asma Lmnawar ... Ydirha Lhob - Video Clip ...  \n\nلتنزيل \"ثلات مرات\" من iTunes:\nhttp://apple.co/1WSxUT7\n\nإشترك في القناة الرسمية لأسما لمنور:\nhttp://bit.ly/AsmaLmnawarYT\n\nأسما لمنور و حسين الجسمي - ثلات مرات (حصرياً) مع الكلمات | 2009\nAsma Lmnawar \u0026 Hussain Al Jassmi - Talat Marat (EXCLUSIVE Lyric Clip) | 2009\n\nكلمات: سمو الشيخ حمدان بن محمد بن راشد آل مكتوم - فزاع\nألحان: فايز السعيد\n\nتوزيع ديجيتال: شركة قنوات\n\nكلمات الأغنية:\nثلاث مرات وانت تدور فراقي وثلاث مرات وانا اقول لا ترحل\nالظاهر ان الغلا ما عاد له باقي بين وبينك اشوف الوضع مستفحل\nعشرة زمن تجبر المشتاق يشتاقي سحرتها بالهجر والوصل ما يسحر\nعليك صابر وهذي قيمة اخلاقي لان ارض الوفا دون الوفا تمحل\nلانك الغالي اللي حرك اشواقي بمكحلات العيون اللي بلا مكحل\nبالرقه انت الارق وذوقك الراقي وبين الخصور النواحل خصرك الانحل\nوقلوب عشاقك اللي كثر عشاقي عيونهم نحل لان شفاتك المنحل\nاصعب سؤال بحياتي يا العاشق الشاقي اللي طرحته عليك وما لقيت الحل\nوشلون ترحل وحبك وسط الاعماقي وانا نويت الرحيل وما قدرت ارحل \nـــــــــــــ\nتابع أسما لمنور:\nLike on Facebook:   / asmalmnawarpage  \nFollow on Instagram:   / asmalmnawar  \nFo