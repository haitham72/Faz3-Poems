","value":452984831},{"key":"USER_INTERFACE_THEME_LIGHT","value":218103808}]}}}}},{"textDecorator":{"highlightTextDecorator":{"startIndex":2234,"length":19,"backgroundCornerRadius":8,"bottomPadding":1,"highlightTextDecoratorExtensions":{"highlightTextDecoratorColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":452984831},{"key":"USER_INTERFACE_THEME_LIGHT","value":218103808}]}}}}},{"textDecorator":{"highlightTextDecorator":{"startIndex":2273,"length":24,"backgroundCornerRadius":8,"bottomPadding":1,"highlightTextDecoratorExtensions":{"highlightTextDecoratorColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":452984831},{"key":"USER_INTERFACE_THEME_LIGHT","value":218103808}]}}}}}]},"headerRuns":[{"startIndex":0,"length":72,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":72,"length":20,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":92,"length":1973,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2065,"length":28,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2093,"length":19,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2112,"length":21,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2133,"length":20,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2153,"length":19,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2172,"length":22,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2194,"length":19,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2213,"length":21,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2234,"length":19,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2253,"length":20,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2273,"length":24,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294963440,"raisedBackground":4294963440,"additiveBackground":566838602,"textPrimary":4281731596,"textSecondary":4285413948,"invertedBackground":4287568158,"overlayBackground":3426093580},"darkThemeColorPalette":{"baseBackground":4280025603,"raisedBackground":4281731596,"additiveBackground":734610762,"textPrimary":4294631649,"textSecondary":4292717742,"invertedBackground":4293098624,"overlayBackground":3426093580},"colorSampledDescriptionBodyText":{"content":"اشترك الآن في قناة فايز السعيد الرسمية للحصول على أجدد إصداراته الفنية \nhttp://goo.gl/iyOky9\n\nالوسمي - جسر الصداقة (فيديو كليب - حصريًا) | 2016\nAlwasmy - Jisr alsadaqah (Music Video - EXCLUSIVE) | 2016\n \nكلمات : سمو الشيخ حمدان بن محمد بن راشد آل مكتوم (فزاع)\nالحان : سفير الالحان فايز السعيد\nاداء : الوسمي\nإخراج :ياسر الياسري\nتوزيع ديجيتال: شركة قنوات\n\nكلمات الأغنية:\nالضـايق اللي سـاريٍ لـيله ولا حَصَّـل طريق\nتلـعــب به الايّـام بيـن يْـميـنهـا وشْـمالـها\nيا غَـارقٍ بالهَم لا تطـلب نجاتك من غريق\nالصبر مفـتاح الـفرج ، والـناس هـذا حالها\n\nوانا ترى مَتني يشيل مْن الحِمِل ما لا يطيق\nمالي ومـال الـحِـمله اللي كل كـتفٍ شـالها\nوالدلّـه اللي ماتـقهوي ضيفها ، قِل للبريق\nيرسل تعـازي ضـوّها لا فاحت بْفـنجـالها\n\nأيّامنا بين الشهر واليوم ، والباقي سحيق\nالايّام كم يبغى لها ، والناس كم يبغى لها\nقمريّة الأحزان لا غَنَّت على الغصن الدقيق\nما تْعـاتب الـمحزون لو غَنَّت وَلا غَنَّى لها\n\nيا ناس وش حَل الرفيق اللي يعاتب له رفيق\nلا حَدِّتـه الايّـام ، والدنـيا عـلى منـوالها\nلا تحسب ان اللي تحبَّه لا جَرَحته ما يضيق\nلو يسـتر جْـروحه عـليك وعِـلِّـتـه ما قالــها\n\nيضيق لكن مَبْسمه ضَحَّاك وِحْجَاجه طليق\nلان الصَّداقه كنز ، والحَسْـنَه بِعَشْـر امثالـها\nوالحقد في قلوب الرجال اهْل الوفا ماهو يليق\nقـلـوبـها تبقى نـظـيفه .. لـو تـغَـيَّـر حـالـها\n\nوانا لو ابني للصداقه جسر لعيـون الصـديق\nالـناس من كثر الزعل ، فال الله وْلا فالــها\nالعـذر مايكفي من التـقدير ، والصدَّه تعـيق\nالوصـل من بيـن الـقـلـوب اللـي تـمـد حْـبالـها\n\nوالالماس سِعره فوق سِعرك يالذهب لو لك بريق\nسِـعره لـحَاله .. والذهب تسـعـيرته بلْـحَالـها\nواهْل الجواهر يفرقون الكـهرمان مْن العقـيق\nلو تخـلـط الثـنتيـن بنـتٍ فـي طَـرَف سلسالها\n\nنَصبر على قَرص النحَل حتى نوصِّل للرحيق\nواهل الهـوى يمسـح خطـاياها لـذيذ وْصـالـها\nوالـناس لاجـل آمالـها تحـتاج للفـهم الدقـيق\nواللي ما تمـلك فَـهـم تخسـر نفـسـها وآمـالـها\n\nجْبال الارض الشامخه يا منكر الـمجد العريق\nهـامـاتنا من كـبر هـيبتنا ، تطـول جْـبالـها\nجديـدنا مستـقـبلٍ زاهـر ، وماضـينا عتـيق\nمسـيرة الـتاريخ يـبقـى مـجـدنا فـي بـالـها\n\nلو ان حَـضارتنا قصيدة شـاعرٍ فكـره عمـيق\nما كان غير محـمد الـمكـتــــوم صـاغ امثـالها\nــــــــــــــــــــــ .\nOfficial Website: http://www.fayez-alsaeed.com\nOfficial Google+: https://goo.gl/B4244h \nOfficial Twitter:   / fayezofficial   \nOfficial Instagram:   / fayez_alsaeed   \nOfficial Facebook:   / fayezofficial   \nOfficial Youtube:    / fayezalsaeedsound  ","commandRuns":[{"startIndex":72,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAYiEwia9cSkwOKSAxVS8kkHHUygM0BIkK6RpZCxkJXiAcoBBCdNc0s=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbmozOE5mWjlfOHhKSEN0ZzJ1SGZfMVR5NjVOd3xBQ3Jtc0trMDFYYm5Ecl85QW1hMW1pSXZXZGVyRzlJTXR6dUpJWTN3RkVVbkRLSEs2S191VndoZF9ONnBNU3JYZlh0dFNRTV9TSUhJWHVnQlRvMGJSRGNMakV2ZXNsLTFnenJqcUM5N2VyQ0FQTDRQSWNhZlUzTQ\u0026q=http%3A%2F%2Fgoo.gl%2FiyOky9\u0026v=4ipBiQSkVxA","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbmozOE5mWjlfOHhKSEN0ZzJ1SGZfMVR5NjVOd3xBQ3Jtc0trMDFYYm5Ecl85QW1hMW1pSXZXZGVyRzlJTXR6dUpJWTN3RkVVbkRLSEs2S191VndoZF9ONnBNU3JYZlh0dFNRTV9TSUhJWHVnQlRvMGJSRGNMakV2ZXNsLTFnenJqcUM5N2VyQ0FQTDRQSWNhZlUzTQ\u0026q=http%3A%2F%2Fgoo.gl%2FiyOky9\u0026v=4ipBiQSkVxA","target":"TARGET_NEW_WINDOW","n