_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1663,"length":21,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964976,"raisedBackground":4294964976,"additiveBackground":566853445,"textPrimary":4281736458,"textSecondary":4285419834,"invertedBackground":4287581465,"overlayBackground":3426098442},"darkThemeColorPalette":{"baseBackground":4280028674,"raisedBackground":4281736458,"additiveBackground":734625605,"textPrimary":4294634720,"textSecondary":4292723116,"invertedBackground":4293110652,"overlayBackground":3426098442},"colorSampledDescriptionBodyText":{"content":"لتنزيل \"أنت ذهب\" من iTunes:\nhttp://apple.co/1yqdh9I\n\nللاستماع لأغنية \"أنت ذهب\" على Apple Music:\nhttp://apple.co/2drzRpB\n\nاشترك في قناة حسين الجسمي الرسمية\nhttp://bit.ly/HussainAlJassmiYT\n\nحسين الجسمي - أنت ذهب (النسخة الأصلية) | 2011\nHussain AlJassmi - Dahab (Official Audio) 2011\n\nمن أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم \"فزّاع\"\nألحــان : فايز السعيد\n \nHUSSAIN AL JASSMI. All rights reserved © \n\nكلمات الاغنية:\nانته ذهب من دون ما تلبس ذهـب وش له تروح السوق واتدور عليه \nسبحان من سواه و جلّ من وهـب حـلاك بيدينـك كأنـك منتقـيـه \nشفايفك جمره و ثغرك مـن لهـب خايف على خدك لهب ثغرك يجيـه \nلو كان رمشك ينهب كـان انهـب من كل عاقل شاف رمشك او سفيه \nلا ترتهب ما فيـه واحـد يرتهـب من واحـد يحبـه و خفاقـه يبيـه \nانا في مهب الريح الا انت افـمهب شوقٍ سكن قلبي و قلبي محتويـه \nذهب معك قلبي يا ليته مـا ذهـب لاقلت عوّد قال انا با مـوت فيـه \nتدري وش يخلي جروحي تلتهـب اني اخلـي شـي وانـا مشتهيـه \nانت ذهب من دون ما تلبس ذهـب وش له تروح السوق و اتدور عليه \nـــــــــــــ\nOfficial Website: http://www.hussainaljassmi.com\nOfficial Twitter:   / 7sainaljassmi   \nOfficial Instagram:   / 7sainaljassmi   \nOfficial Facebook:   / hussainaljassmi  \nOfficial Google+: https://google.com/+HussainAlJassmi\nOfficial Youtube:    / hussainaljassmi   Official SoundCloud:   / officialhussai.  . . .\nOfficial Website: http://www.hussainaljassmi.com\nOfficial iTunes: http://apple.co/1UcsKU4\nOfficial iTunes Connect: https://itun.es/eg/EsJf0\nOfficial Twitter:   / 7sainaljassmi   \nOfficial Instagram:   / 7sainaljassmi   \nOfficial Facebook:   / hussainaljassmi  \nOfficial Google+: https://plus.google.com/+HussainAlJassmi\nOfficial Youtube:    / hussainaljassmi   \nOfficial SoundCloud:   / hussainaljassmi  ","commandRuns":[{"startIndex":28,"length":23,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCAQ040EGAYiEwj8jPmiwOKSAxWjkTcIHauhAcZIxpqu07nD3IefAcoBBPUn23g=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbUZicFJJMUp0ZDZDMjc0SHpjMWlCY2ZvMzVkQXxBQ3Jtc0ttLXoxenJUYWRUYS1HS28tOE9lY0NBSHF4OXVPWi1TVzk3OXRWVFdOMnNNYlVlZm9iUmRyQW1nNTJFNTk5eWtZdTcxZm1aYUZsQWw1elRYMG1OWmc4T2JmWHl2M01IdG5UcU1fSmxDTUU4Snl4R0daRQ\u0026q=http%3A%2F%2Fapple.co%2F1yqdh9I\u0026v=nw9yG5prjUY","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbUZicFJJMUp0ZDZDMjc0SHpjMWlCY2ZvMzVkQXxBQ3Jtc0ttLXoxenJUYWRUYS1HS28tOE9lY0NBSHF4OXVPWi1TVzk3OXRWVFdOMnNNYlVlZm9iUmRyQW1nNTJFNTk5eWtZdTcxZm1aYUZsQWw1elRYMG1OWmc4T2JmWHl2M01IdG5UcU1fSmxDTUU4Snl4R0daRQ\u0026q=http%3A%2F%2Fapple.co%2F1yqdh9I\u0026v=nw9yG5prjUY","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":96,"length":23,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCAQ040EGAYiEwj8jPmiwOKSAxWjkTcIHauhAcZIxpqu07nD3IefAcoBBPUn23g=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqa3EwVXlON1VjM1VJTzRVSzdQWU5qSktCbTJMd3xBQ3Jtc0tsMGo1ZmxvYmRHY0F1N01WeVF0NGFPZWpLUG9HT1hVRHdrWDRDVW1XNWF3U2xPTXdyLW81WkV6SERHb2dJOS1VYU1jcFRWcTZrcGhsekw0aGlVRjZVNW04bU1zZ3ZJbUU2R05Ka1NzWE41aDBPbTc4VQ\u0026q=http%3A%2F%2Fapple.co%2F2drzRpB\u0026v=nw9yG5prjUY","webPageType"