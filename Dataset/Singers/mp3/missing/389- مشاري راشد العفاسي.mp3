ylist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"addedVideoId":"XvgzeRmcaig","action":"ACTION_ADD_VIDEO"}]}},"removeFromWatchLaterCommand":{"clickTrackingParams":"CAAQu2kiEwitgvTwwOKSAxVCRE8EHaz7BSvKAQTjhg9o","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/browse/edit_playlist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"action":"ACTION_REMOVE_VIDEO_BY_VIDEO_ID","removedVideoId":"XvgzeRmcaig"}]}}}}},"storyboards":{"playerStoryboardSpecRenderer":{"spec":"https://i.ytimg.com/sb/XvgzeRmcaig/storyboard3_L$L/$N.jpg?sqp=-oaymwGhAUg48quKqQOYAYgBAZUBAAAEQpgBMqABPKgBBLIBQBANDBAVHyYtDg4PEhcrLCkPDhAVHyoyKQ8RFBgmPTgtERQeKjFLRzYVHCkuOUdNPyUuNz1HUlFFM0BCQ0xERkO6AUARERUjRENDQxETFi9DQ0NDFRYpQ0NDQ0MjL0NDQ0NDQ0RDQ0NDQ0JCQ0NDQ0NCQkJDQ0NDQkJCQkNDQ0JCQkJCovOX_wMGCNC2190F|48#27#100#10#10#0#default#rs$AOn4CLDpEK0cCprUnz-zY9WExOK2Nx7RVg|80#45#73#10#10#5000#M$M#rs$AOn4CLAEnhhYJ3ksEkBMxI6jbeWgeqqVwg|160#90#73#5#5#5000#M$M#rs$AOn4CLAMVbgqxWmqzfS25UIVFKwazXG5ew","recommendedLevel":2,"highResolutionRecommendedLevel":2}},"microformat":{"playerMicroformatRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/XvgzeRmcaig/maxresdefault.jpg","width":1280,"height":720}]},"embed":{"iframeUrl":"https://www.youtube.com/embed/XvgzeRmcaig","width":1280,"height":720},"title":{"simpleText":"الجروح | مشاري راشد العفاسي Al-juruh Nashid Mishary Alafasy"},"description":{"simpleText":"🔔 لا تنس دعم القناة بالاشتراك وتفعيل الجرس ليصلك كل جديد.\nاضغط إعجاب وشارك المقطع مع من تحب، فـ الدال على الخير كفاعله.\nحين تنشر تلاوة أو دعاء، فأنت تُعين على ذكر الله وتؤجر بإذن الله، فلعلها تكون سببًا لهداية قلب أو سكينة نفس.\nاستكشف المزيد من التلاوات، والمقاطع الهادفة والمميزة في قوائم التشغيل المتنوعة على القناة.\nبارك الله فيكم، ونفعنا وإياكم بالقرآن العظيم\n\nاشترك الآن في خدمة القرآن :\nhttps://www.youtube.com/@alafasy?sub_confirmation=1\n\nاخترنا لك : 50 تلاوة مميزة للقارئ مشاري راشد العفاسي\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN\u0026feature=shared\n\nمصحف قديم الشيخ مشاري راشد العفاسي\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSqc3yePg5cstFT3lpStFUb1\u0026feature=shared\n\nمصحف كاليفورنيا من صلاة التراويح \nhttps://youtube.com/playlist?list=PL2hoGhz2jBSr0F3k9hIYqsllrqKlMLn1V\u0026feature=shared\n\nالمصحف المرتل الأول الذي سُجل في الكويت ومصر  عام 2003م 1424هـ\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSpGpWPEQv5LjwVlTMYXXxnC\u0026feature=shared\n\nمصحف القرآءات العشر الجديد \nhttps://youtube.com/playlist?list=PL2hoGhz2jBSroDP_SDhYNMCOAkzHozQZo\u0026feature=shared\n\nجميع أناشيد القارئ مشاري راشد العفاسي\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSq-5dulEtVsDxIEBn1BJsrS\u0026feature=shared\n\nالأدعية وأذكار الصباح والمساء والرقية الشرعية\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSqosLJN5ECy3KsgT_Pu8kNX\u0026feature=shared\n\nمن أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم \nألحان فايز السعيد\nتوزيع مصطفى قاسم واحمد سعيد\nاداء وهندسة صوتية \nمشاري راشد العفاسي\n\nالله خلق لي نفس تسـمو على البوح\n\nماهـيب لا ضاقـت من الهـم باحـت\n\nعلى كثر ما شفت ضيقات وجروح\n\nلا الوجه متغـيّر ولا العـين صاحت\n\nأبـشـّرك .. بـشـارة الـروح للـروح\n\nتـبي تطـيّحـني اللـيـالي و طـاحـت\n\nهـذا أنـا والـوجـه باسـم ومـشـروح\n\nوجهٍ بروقـه لمعـظم الناس لاحـت\n\nكم محزن ٍ بنى على شـوفه صروح\n\nوكم نفس من طارف عطاه استراحت\n\nألله وهـبـنا عـز و امجـاد و طمـوح\n\nوذكـر ٍعـلى جـدران الايـّـام ناحِـت\n\nهذي مراجل ماهي بضحك ومزوح\n\nماهي شموع لا ضوا الصبح ساحت\n\nالصـفح خصله والفخر ماله سطوح\n\nوالحزن لا سيطر على الروح ناحت\n\nبعض الجروح تجي لك شوي وتروح\n\nوبعض الجروح ان جات ماعاد راحت"},"lengthSeconds":"359","ownerProfileUrl":"http://www.youtube.com/@alafasy","externalChannelId":"UCmMcOjsVehVlEOteyrhjI2Q","isFamilySafe":true,"availableCountries":["AD","AE","AF","AG","AI","AL","AM","AO","AQ","AR","AS","AT","AU","AW","AX","AZ","BA","BB","BD","BE","BF","BG","BH","BI","BJ","BL","BM","BN","BO","BQ","BR","BS","BT","BV","BW","BY","BZ","CA","CC","CD","CF","CG","CH","CI","CK","CL","CM","CN","CO","CR","CU","CV","CW","CX","CY","CZ","DE","DJ","DK","DM","DO","DZ","EC","EE","EG","EH","ER","ES","ET","FI","FJ","FK","FM","FO","FR","GA","GB","GD","GE","GF","GG","GH","GI","GL","GM","GN","GP","GQ","GR","GS","GT","GU","GW","GY","HK","HM","HN","HR","HT","HU","ID","IE","IL","IM","IN","IO","IQ","IR","IS","IT","JE","JM","JO","JP","KE","KG","KH","KI","KM","KN","KP","KR","KW","KY","KZ","LA","LB","LC","LI","LK","LR","LS","LT","LU","LV","LY","MA","MC","MD","ME","MF","MG","MH","MK","ML","MM","MN","MO","MP","MQ","MR","MS","MT","MU","MV","MW","MX","MY","MZ","NA","NC","NE","NF","NG","NI","NL","NO","NP","NR","NU","NZ","OM","PA","PE","PF","PG","PH","PK","PL","PM","PN","PR","PS","PT","PW","PY","QA","RE","RO","RS","RU","RW","SA","SB","SC","SD","SE","SG","SH","SI","SJ","SK","SL","SM","SN","SO","SR","SS","ST","SV","SX","SY","SZ","TC","TD","TF","TG","TH","TJ","TK","TL","TM","TN","TO","TR","TT","TV","TW","TZ","UA","UG","UM","US","UY","UZ","VA","VC","VE","VG","VI","VN","VU","WF","WS","YE","YT","ZA","ZM","ZW"],"isUnlisted":false,"hasYpcMetadata":false,"viewCount":"832429","category":"Music","publishDate":"2018-10-04T05:04:04-07:00","ownerChannelName":"Alafasy","uploadDate":"2018-10-04T05:04:04-07:00","isShortsEligible":false,"externalVideoId":"XvgzeRmcaig","likeCount":"8508","canonicalUrl":"https://www.youtube.com/watch?v=XvgzeRmcaig"}},"cards":{"cardCollectionRenderer":{"cards":[{"cardRenderer":{"teaser":{"simpleCardTeaserRenderer":{"message":{"simpleText":"الاطّلاع على التصحيحَين"},"trackingParams":"CBIQ0DYiEwitgvTwwOKSAxVCRE8EHaz7BSs=","prominent":true,"logVisibilityUpdates":true,"onTapCommand":{"clickTrackingParams":"CBIQ0DYiEwitgvTwwOKSAxVCRE8EHaz7BSvKAQTjhg9o","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-error-corrections","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}}}},"cueRanges":[{"startCardActiveMs":"0","endCardActiveMs":"5000","teaserDurationMs":"6000","iconAfterTeaserMs":"5000"}],"trackingParams":"CBEQtZcBGAAiEwitgvTwwOKSAxVCRE8EHaz7BSs="}}],"headerT