tnNDNtYk5HeGlTayDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"492,710"},"label":{"simpleText":"عدد المشاهدات"},"accessibilityText":"492,710 مشاهدات","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293980927,"raisedBackground":4293980927,"additiveBackground":558193609,"textPrimary":4278849846,"textSecondary":4282008174,"invertedBackground":4279839631,"overlayBackground":3423211830},"darkThemeColorPalette":{"baseBackground":4278322716,"raisedBackground":4278849846,"additiveBackground":725965769,"textPrimary":4292928762,"textSecondary":4289508317,"invertedBackground":4286352611,"overlayBackground":3423211830},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2009"},"label":{"simpleText":"2 يوليو"},"accessibilityText":"02‏/07‏/2009","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293980927,"raisedBackground":4293980927,"additiveBackground":558193609,"textPrimary":4278849846,"textSecondary":4282008174,"invertedBackground":4279839631,"overlayBackground":3423211830},"darkThemeColorPalette":{"baseBackground":4278322716,"raisedBackground":4278849846,"additiveBackground":725965769,"textPrimary":4292928762,"textSecondary":4289508317,"invertedBackground":4286352611,"overlayBackground":3423211830},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBgQ040EGAYiEwjV17uhwOKSAxXUzUkHHTzFI7fKAQSRfHeM","commandMetadata":{"webCommandMetadata":{"url":"/@asmalmnawar","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCSeCHtLvsdwTKtIoGgOroHg","canonicalBaseUrl":"/@asmalmnawar"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/VScmwldpKb3ktiRvvpPfVLI3FCdbo5vg3SS09OFK_YH-_S5_tJrKCm8qc7zuSJm0yDq0gB3r=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"عرض المزيد"}},"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"attributedDescriptionBodyText":{"content":"شاهد كليب يديرها الحب من هنا :    • Asma Lmnawar ... Ydirha Lhob - Video Clip ...  \n\nلتنزيل \"ثلات مرات\" من iTunes:\nhttp://apple.co/1WSxUT7\n\nإشترك في القناة الرسمية لأسما لمنور:\nhttp://bit.ly/AsmaLmnawarYT\n\nأسما لمنور و حسين الجسمي - ثلات مرات (حصرياً) مع الكلمات | 2009\nAsma Lmnawar \u0026 Hussain Al Jassmi - Talat Marat (EXCLUSIVE Lyric Clip) | 2009\n\nكلمات: سمو الشيخ حمدان بن محمد بن راشد آل مكتوم - فزاع\nألحان: فايز السعيد\n\nتوزيع ديجيتال: شركة قنوات\n\nكلمات الأغنية:\nثلاث مرات وانت تدور فراقي وثلاث مرات وانا اقول لا ترحل\nالظاهر ان الغلا ما عاد له باقي بين وبينك اشوف الوضع مستفحل\nعشرة زمن تجبر المشتاق يشتاقي سحرتها بالهجر والوصل ما يسحر\nعليك صابر وهذي قيمة اخلاقي لان ارض الوفا دون الوفا تمحل\nلانك الغالي اللي حرك اشواقي بمكحلات العيون اللي بلا مكحل\nبالرقه انت الارق وذوقك الراقي وبين الخصور النواحل خصرك الانحل\nوقلوب عشاقك اللي كثر عشاقي عيونهم نحل لان شفاتك المنحل\nاصعب سؤال بحياتي يا العاشق الشاقي اللي طرحته عليك وما لقيت الحل\nوشلون ترحل وحبك وسط الاعماقي وانا نويت الرحيل وما قدرت ارحل \nـــــــــــــ\nتابع أسما لمنور:\nLike on Facebook:   / asmalmnawarpage  \nFollow on Instagram:   / asmalmnawar  \nFollow on Twitter:   / asmalmnawar  \nAdd on SnapChat:   / asmalmnawar1  \nFollow on Google+: https://plus.google.com/+AsmaLmnawar\nOfficial iTunes: http://bit.ly/AsmaLmnawariTunes\nOfficial YouTube: http://bit.ly/AsmaLmnawarYT","commandRuns":[{"startIndex":31,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQ040EGAYiEwjV17uhwOKSAxXUzUkHHTzFI7fKAQSRfHeM","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=_6ylCkxPdF4","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"_6ylCkxPdF4","startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"co