"runs":[{"text":"إلغاء الاشتراك"}]},"serviceEndpoint":{"clickTrackingParams":"CK0CEPBbIhMI74CCpMDikgMVBtdJBx29TRahKPgdMgV3YXRjaMoBBJyYDVs=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UCQd1_s2J6NvI-7YYN6MkIxA"],"params":"CgIIAxILNzVoT1pyM3RjX3cYAA%3D%3D"}},"accessibility":{"label":"إلغاء الاشتراك"},"trackingParams":"CK0CEPBbIhMI74CCpMDikgMVBtdJBx29TRah"}},"cancelButton":{"buttonRenderer":{"style":"STYLE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"إلغاء"}]},"accessibility":{"label":"إلغاء"},"trackingParams":"CKwCEPBbIhMI74CCpMDikgMVBtdJBx29TRah"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CKkCEM2rARgBIhMI74CCpMDikgMVBtdJBx29TRah"}},"showMoreText":{"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"trackingParams":"CKkCEM2rARgBIhMI74CCpMDikgMVBtdJBx29TRah","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CKkCEM2rARgBIhMI74CCpMDikgMVBtdJBx29TRahygEEnJgNWw==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CKkCEM2rARgBIhMI74CCpMDikgMVBtdJBx29TRahygEEnJgNWw==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CKkCEM2rARgBIhMI74CCpMDikgMVBtdJBx29TRahygEEnJgNWw==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CKkCEM2rARgBIhMI74CCpMDikgMVBtdJBx29TRahygEEnJgNWw==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"Balqees Fathi \u0026 Abu Bakr Salem - AlShear Diwan | بلقيس فتحي و أبو بكر سالم - الشعر ديوان\n\nكلمات: الشيخ حمدان بن محمد بن راشد - فزاع\nألحان: فايز السعيد\n\nكلمات الاغنية \nالشعر ديوان ماضي عربنا والأداه\nألتي كانت توضح لنا عاداتها \nدايمٍ من يكتبه إيتمنّى من قراه\nالتبحّر في القصيدة عبر كلماتها\nبس انا ما قلته اطمع لشهره من وراه\nقلته أداوي جروح البشر واهاتها\nكيف يطمح فيه واحد ذِكِر جَدّه واباه\nإصنعت مكانته من عظم وقفاتها\nليس مثلي من قصيدة ترفع مستواه \nلو من اللولو والمرجان صغت أبياتها \nكم صغير(ن) في العمر وصل للعالم نباه\nوصادم بهامته ناس لها هاماتها\nبالمكارم تسمع اسمه من أفواه الرواه\nوغيره اسمه حسب دخل عقاراتها\nلو عمينا العين و اشلون نكتم كل فاه\nوالعرب أكثر ما فيها عدد رواتها\nوالصديق اللي يتضايق من صديقه شو بلاه\nغرته دنياه يوم كثرت لذاتها\nالصديق من الصديق يتحمله خطاه\nوالأصدقاء مع بعضها حسب نياتها\nوابن آدم كل واحد حسب ما الله عطاه\nسيئآت الناس ماهي مثل حسناتها\nوالدول مع بعضها لو يصير اشتباه \nبتقدم مصلحتها على أزماتها\nكم نصحته والنصيحة من المسلم لأخآه\nوقلت له يا خلها معك وإلا هاتها\nوأنت بعت الود والود ومن باعه شرآه\nوأعرف مشاعر الناس من نظراتها\nالسؤال اللي يراودني على كل اتجاه \nعند مثلك سلعة الطيب كم دفعاتها \nلا تحسب ان كل جافي بكت عيني جفاه \nلي مقاماتي وللناس مقاماتها \nشخص لا من غاب بعده يشتت الإنتباه\nوشخص لا من غاب بنفسك تحس بذاتها\nناس نبكيها لو أنها على قيد الحياة \nوناس ما يأثر علينا خبر وفاتها\n\nإنضموا لقناة بلقيس الرسمية على يوتيوب وشاهدوا أحدث أعمالها:\nhttp://goo.gl/NQVQ2F\n\nتابع بلقيس على: \nhttps://balqeess.lnk.to/Platforms\n\nDigital Distribution: Chabaka\n  / chabaka.music  ","commandRuns":[{"startIndex":1367,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CKkCEM2rARgBIhMI74CCpMDikgMVBtdJBx29TRahSPznte_rzJPM7wHKAQScmA1b","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqblF4dk1ncmUtd28weXVEOWpObWhqRXNfOUdOQXxBQ3Jtc0ttRDc3MTBhOUd1ZnpHOHRaMEFZR2xwTE5kQnlJRURDTTFuZUZ1NUZyRFU4MHlyZGFyTi03UzZlaGZ4NG9JaXdRRW90OGVuTC15MC14aHhZQkV2MVBsOEt4TF9KR1FuWnJvUkprMHRZcXVYY3B4cXpDWQ\u0026q=http%3A%2F%2Fgoo.gl%2FNQVQ2F\u0026v=75hOZr3tc_w","webPageType":"