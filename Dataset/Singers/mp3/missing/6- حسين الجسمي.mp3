ry":4292723116,"invertedBackground":4293110652,"overlayBackground":3426098442},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2015"},"label":{"simpleText":"12 فبراير"},"accessibilityText":"12‏/02‏/2015","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964976,"raisedBackground":4294964976,"additiveBackground":566853445,"textPrimary":4281736458,"textSecondary":4285419834,"invertedBackground":4287581465,"overlayBackground":3426098442},"darkThemeColorPalette":{"baseBackground":4280028674,"raisedBackground":4281736458,"additiveBackground":734625605,"textPrimary":4294634720,"textSecondary":4292723116,"invertedBackground":4293110652,"overlayBackground":3426098442},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CCAQ040EGAYiEwj8jPmiwOKSAxWjkTcIHauhAcbKAQT1J9t4","commandMetadata":{"webCommandMetadata":{"url":"/@HussainAlJassmi","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC3WI3Ut8Hvc6kzlLcG0IJHw","canonicalBaseUrl":"/@HussainAlJassmi"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/wHJiXzddUXsVsDoFnoNlklKJ8wyN82uOU85zbXhXW9-miwNqFDEhB3oHdf72RRPWEBn4MaZc6w=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"عرض المزيد"}},"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"attributedDescriptionBodyText":{"content":"لتنزيل \"أنت ذهب\" من iTunes:\nhttp://apple.co/1yqdh9I\n\nللاستماع لأغنية \"أنت ذهب\" على Apple Music:\nhttp://apple.co/2drzRpB\n\nاشترك في قناة حسين الجسمي الرسمية\nhttp://bit.ly/HussainAlJassmiYT\n\nحسين الجسمي - أنت ذهب (النسخة الأصلية) | 2011\nHussain AlJassmi - Dahab (Official Audio) 2011\n\nمن أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم \"فزّاع\"\nألحــان : فايز السعيد\n \nHUSSAIN AL JASSMI. All rights reserved © \n\nكلمات الاغنية:\nانته ذهب من دون ما تلبس ذهـب وش له تروح السوق واتدور عليه \nسبحان من سواه و جلّ من وهـب حـلاك بيدينـك كأنـك منتقـيـه \nشفايفك جمره و ثغرك مـن لهـب خايف على خدك لهب ثغرك يجيـه \nلو كان رمشك ينهب كـان انهـب من كل عاقل شاف رمشك او سفيه \nلا ترتهب ما فيـه واحـد يرتهـب من واحـد يحبـه و خفاقـه يبيـه \nانا في مهب الريح الا انت افـمهب شوقٍ سكن قلبي و قلبي محتويـه \nذهب معك قلبي يا ليته مـا ذهـب لاقلت عوّد قال انا با مـوت فيـه \nتدري وش يخلي جروحي تلتهـب اني اخلـي شـي وانـا مشتهيـه \nانت ذهب من دون ما تلبس ذهـب وش له تروح السوق و اتدور عليه \nـــــــــــــ\nOfficial Website: http://www.hussainaljassmi.com\nOfficial Twitter:   / 7sainaljassmi   \nOfficial Instagram:   / 7sainaljassmi   \nOfficial Facebook:   / hussainaljassmi  \nOfficial Google+: https://google.com/+HussainAlJassmi\nOfficial Youtube:    / hussainaljassmi   Official SoundCloud:   / officialhussai.  . . .\nOfficial Website: http://www.hussainaljassmi.com\nOfficial iTunes: http://apple.co/1UcsKU4\nOfficial iTunes Connect: https://itun.es/eg/EsJf0\nOfficial Twitter:   / 7sainaljassmi   \nOfficial Instagram:   / 7sainaljassmi   \nOfficial Facebook:   / hussainaljassmi  \nOfficial Google+: https://plus.google.com/+HussainAlJassmi\nOfficial Youtube:    / hussainaljassmi   \nOfficial SoundCloud:   / hussainaljassmi  ","commandRuns":[{"startIndex":28,"length":23,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCAQ040EGAYiEwj8jPmiwOKSAxWjkTcIHauhAcZIxpqu07nD3IefAcoBBPUn23g=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbGlFWVV5bTVMUjVtSG92Wkk1TkpFQzVGd0UwUXxBQ3Jtc0tuQ0FyRjItbzdrUDFGaXJuamJmd2FyNEVyUGw4ejFZSks0LV84dENfa0FLdnRCeVBaOExKN2x3bTAydC02bUh1YkhpRjB4MFhHM3h1QjhSLXoyVkpTaVhpbTExbkt3RW9jTVlIZE1BNVBEUkJKSlp3VQ\u0026q=http%3A%2F%2Fapple.co%2F1yqdh9I\u0026v=nw9yG5prjUY","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"htt