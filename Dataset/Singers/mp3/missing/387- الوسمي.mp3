bel=followon_view\u0026ptype=f_view\u0026random=606805713\u0026utuid=sja3yhqEf6ju5Ji9WS6SsA","elapsedMediaTimeSeconds":0},"googleRemarketingUrl":{"baseUrl":"https://www.google.com/pagead/1p-user-list/962985656/?backend=innertube\u0026cname=1\u0026cver=2_20260213\u0026data=backend%3Dinnertube%3Bcname%3D1%3Bcver%3D2_20260213%3Bm%3D1%3Bptype%3Df_view%3Btype%3Dview%3Butuid%3Dsja3yhqEf6ju5Ji9WS6SsA%3Butvid%3D2BwaKqvPD2E%3Bw%3D1\u0026is_vtc=0\u0026ptype=f_view\u0026random=640776077\u0026utuid=sja3yhqEf6ju5Ji9WS6SsA","elapsedMediaTimeSeconds":0}},"videoDetails":{"videoId":"2BwaKqvPD2E","title":"الوسمي - رسالة خاصة  - عام 2009 - من أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم  #الوسمي #فزاع","lengthSeconds":"340","keywords":["2019 الوسمي","Al Wasmy","Al Wasmy 2019","Emarati Songs 2019","Exclusive","Khaliji Songs 2019","New 2019","New Release 2019","New song 2019","Shegani Alshoug","UAE","أغاني اماراتية 2019","أغاني خليجية 2019","أغاني عربية 2019","الامارات","الخليج","العمر ما يسوى","العنكبوت","الوسمي - رسالة خاصة - من أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم (فزاع) #الوسمي #فزاع","جديد","جديد 2019","جديد الوسمي","حصرياً","راحة البال","مشتاقلي"],"channelId":"UCsja3yhqEf6ju5Ji9WS6SsA","isOwnerViewing":false,"shortDescription":"رسالة خاصة \nمن اشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم (فزاع)\nالحان فايز السعيد \n\nاشترك الآن في القناه الرسمية للفنان الوسمي:\nhttps://bit.ly/2UlRaNy\n\nالوسمي -  (حصرياً) | 2022 \n\nAl Wasmy -  (Exclusive) | 2022\n\nتوزيع ديجيتال: شركة قنوات\n\nيا صاحبي ياللي لك العز نوماس\nإن كان عندك علم محرجك إطره\nالشعر ما هو حبر في جوف قرطاس\nو لا بحر تقدر تلاعب بشطره\nالشعر بيت يهز لك كل هوجاس\nو أنا البحر وانته من البحر قطره\nالانسان مشكلته إذا ماله احساس\nالناس في تفكيرها تصير خطره\nخطره وهو يصبح خطر ف اعين الناس\nلذلك الانسان يحتاج فطره\nتحاول توازن أموره بمقياس\nولا يعامل من يعامل ببطره\nالطف كأنك ورد عانقه نسناس\nو احسن كأنك عود فواح عطره\nو لا تفتخـر بالجـاه أو قـوة الـبـاس\nو احفظ من التاريخ حكمه وسطره\nالبيت لو قطره يشيد على ساس\nمع مرور الوقت يختل قطره\nخلد فعل و ادعس على هامة الياس\nالعز مهما طال بيروح وطره","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/2BwaKqvPD2E/hqdefault.jpg?sqp=-oaymwE8CKgBEF5IWvKriqkDLwgBFQAAAAAYASUAAMhCPQCAokN4AfABAfgB_gmAAtAFigIMCAAQARhlIEwoYTAP\u0026rs=AOn4CLDyc1b7IyqWMpr3RZWb9j-k8Rsrxg","width":168,"height":94},{"url":"https://i.ytimg.com/vi/2BwaKqvPD2E/hqdefault.jpg?sqp=-oaymwE8CMQBEG5IWvKriqkDLwgBFQAAAAAYASUAAMhCPQCAokN4AfABAfgB_gmAAtAFigIMCAAQARhlIEwoYTAP\u0026rs=AOn4CLCZC0C8hmx65qmz7BCs_wyCY9ETEA","width":196,"height":110},{"url":"https://i.ytimg.com/vi/2BwaKqvPD2E/hqdefault.jpg?sqp=-oaymwE9CPYBEIoBSFryq4qpAy8IARUAAAAAGAElAADIQj0AgKJDeAHwAQH4Af4JgALQBYoCDAgAEAEYZSBMKGEwDw==\u0026rs=AOn4CLC_xUOi2soYxNU0or4jzCvPJ_MeJg","width":246,"height":138},{"url":"https://i.ytimg.com/vi/2BwaKqvPD2E/hqdefault.jpg?sqp=-oaymwE9CNACELwBSFryq4qpAy8IARUAAAAAGAElAADIQj0AgKJDeAHwAQH4Af4JgALQBYoCDAgAEAEYZSBMKGEwDw==\u0026rs=AOn4CLDLUKVJ1oPzAAxzEt0L71oE52LDYw","width":336,"height":188},{"url":"https://i.ytimg.com/vi/2BwaKqvPD2E/maxresdefault.jpg?sqp=-oaymwEmCIAKENAF8quKqQMa8AEB-AH-CYAC0AWKAgwIABABGGUgTChhMA8=\u0026rs=AOn4CLBpGkuoDWH9XYVecslQL5alerydAA","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"31037","author":"Al Wasmy | الوسمي","isLowLatencyLiveStream":false,"isPrivate":false,"isUnpluggedCorpus":false,"latencyClass":"MDE_STREAM_OPTIMIZATIONS_RENDERER_LATENCY_NORMAL","isLiveContent":false},"annotations":[{"playerAnnotationsExpandedRenderer":{"featuredChannel":{"startTimeMs":"0","endTimeMs":"341000","watermark":{"thumbnails":[{"url":"https://i.ytimg.com/an/sja3yhqEf6ju5Ji9WS6SsA/featured_channel.jpg?v=6699444c","width":40,"height":40}]},"trackingParams":"CAYQ8zciEwiOq_rvwOKSAxV550kHHabBO9c=","navigationEndpoint":{"clickTrackingParams":"CAYQ8zciEwiOq_rvwOKSAxV550kHHabBO9cyAml2ygEErniPLQ==","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCsja3yhqEf6ju5Ji9WS6SsA","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtub