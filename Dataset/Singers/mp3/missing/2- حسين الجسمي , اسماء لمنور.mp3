t3.ggpht.com/VScmwldpKb3ktiRvvpPfVLI3FCdbo5vg3SS09OFK_YH-_S5_tJrKCm8qc7zuSJm0yDq0gB3r=s400-c-k-c0x00ffffff-no-rj","width":400,"height":400}]},"icon":{"thumbnails":[{"url":"https://www.gstatic.com/youtube/img/annotations/youtube.png"}]},"left":0.032710284,"width":0.20560747,"top":0.13084112,"aspectRatio":1,"startMs":"356441","endMs":"376441","title":{"accessibility":{"accessibilityData":{"label":"قناة Asma Lmnawar | أسما لمنور"}},"simpleText":"Asma Lmnawar | أسما لمنور"},"metadata":{"simpleText":"القناة الرسمية للفنانة أسما لمنور\nأسما لمنور هي مغنية مغربية ولدت في مدينة الدار البيضاء، وكانت بدايتها بالمجال الغنائي عام 1995 بالسابعة عشر من عمرها من خلال إحدى الأغاني التي أنتجتها الإذاعة الوطنية المغربية. أعجب بها العديد من المغنين وحظيت على تعاون مع الفنان كاظم الساهر والفنان أبو بكر سالم وعبد الله الرويشد وعلي بن محمد وحسين الجسمي، عرفت بتعاونها مع علي بن محمد بأغنية «قلبي دايم معاكم» التي حققت نجاحاً عربيًا.\n \nThe official YouTube channel of Asma Lmnawar\nAsma Lamnawar is a famous Moroccan singer. She made her singing debut in 1995 with \"Angham\", a festival produced by Moroccan Radio and TV, where she won the prize for best interpretation. Her style of singing involves both genres Khaliji and Moroccan music infused together and as a result her songs became a success."},"callToAction":{"simpleText":"الانتقال إلى القناة"},"dismiss":{"simpleText":"إلغاء"},"endpoint":{"clickTrackingParams":"CAYQ-N4BGAAiEwi90buhwOKSAxWPMvEFHYnSBh0yDGl2LWVuZHNjcmVlbkipksaNzc35xoMBygEEkXx3jA==","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCSeCHtLvsdwTKtIoGgOroHg","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCSeCHtLvsdwTKtIoGgOroHg"}},"hovercardButton":{"subscribeButtonRenderer":{"buttonText":{"runs":[{"text":"اشتراك"}]},"subscribed":false,"enabled":true,"type":"FREE","channelId":"UCSeCHtLvsdwTKtIoGgOroHg","showPreferences":false,"subscribedButtonText":{"runs":[{"text":"تم الاشتراك"}]},"unsubscribedButt