R_MAPPING_UNSPECIFIED"},{"startIndex":985,"length":14,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":999,"length":20,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1019,"length":21,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1040,"length":23,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1063,"length":20,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964464,"raisedBackground":4294964464,"additiveBackground":566848837,"textPrimary":4281734921,"textSecondary":4285810741,"invertedBackground":4287642905,"overlayBackground":3426096905},"darkThemeColorPalette":{"baseBackground":4280027650,"raisedBackground":4281734921,"additiveBackground":734620997,"textPrimary":4294699232,"textSecondary":4292917929,"invertedBackground":4293106812,"overlayBackground":3426096905},"colorSampledDescriptionBodyText":{"content":"اشترك في قناة الفنان راشد الماجد الرسمية\nhttp://goo.gl/quusYo\n\nراشد الماجد و حسين الجسمي - اسأل مجرب (النسخة الأصلية) | 2012\nRashed AlMajid \u0026 Hussain AlJassmi - Esaal Mjrb (Official Audio) | 2012\n\nكلمات: الشيخ حمدان بن محمد آل مكتوم (فزاع)\nألحان: فايز السعيد\nتوزيع ديجيتال: شركة قنوات\n\nكلمات الأغنية\nحبيبتي حالي من الشوق داني\nأشرق بحبك .. واعود أغرب\nأناني ف وصلك لكن يالأناني\nترى الأنانيه ف طبعك تخرب\nلحظات حبك حطّمت لي كياني\nوالحزن من بين المحاني تسرب\nتسرب وصكّت عليه المحاني\nكنّه لوصلك بالجروح يتقرب\nيامعرب الأنساب خدر العياني\nسلم العرب لاتجهله يالمعرب\nشربت حبّك لين فاض الحناني\nوقامت عروقي من غلاك تشرب\nياللي تقول اسأل مجرب تراني\nسألت واحد.... بس قام يتهرب\nلاتسأل مجرب ياقلب وتعاني\nإسأل طبيب وخل عنك المجرب\n--------\nتابع الفنان راشد الماجد الآن على الصفحات الرسمية\nOfficial Website: http://www.Rashed.TV\nOfficial iTunes http://apple.co/1KWSl9C\nOfficial iTunes Connect: https://itun.es/eg/E8amJ\nFollow on Twitter:   / rashedtv  \nLike on Facebook:   / rashedtv  \nFollow on Instagram:   / rashedtv  \nFollow on Google+: https://goo.gl/i4VMx9\nSubscribe on YouTube:    / rashedalmajid  ","commandRuns":[{"startIndex":41,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQ040EGAUiEwi2gPmgwOKSAxXJ2kkHHT1EAyRImur0saG-1MufAcoBBBf05GE=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbVpZdy1MQU5qUDN5eXlKSU95T1ROa09MY3gwd3xBQ3Jtc0trU2FJcXVPM2RJbG1rcmF3NklmQzNVcy1TSER0RkQ5TG9IRl9La1k5bF8zTGszeGhaOE0tQzlHeWwtT0JldERjT09IcXhjQkRWbVlMTWNHNnRrVGVVOXF4YkZFM2xIOEhYMWJ1ZWdfREVVZE95ZTJ1WQ\u0026q=http%3A%2F%2Fgoo.gl%2FquusYo\u0026v=n5dR8hY9NRo","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbVpZdy1MQU5qUDN5eXlKSU95T1ROa09MY3gwd3xBQ3Jtc0trU2FJcXVPM2RJbG1rcmF3NklmQzNVcy1TSER0RkQ5TG9IRl9La1k5bF8zTGszeGhaOE0tQzlHeWwtT0JldERjT09IcXhjQkRWbVlMTWNHNnRrVGVVOXF4YkZFM2xIOEhYMWJ1ZWdfREVVZE95ZTJ1WQ\u0026q=http%3A%2F%2Fgoo.gl%2FquusYo\u0026v=n5dR8hY9NRo","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":786,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQ040EGAUiEwi2gPmgwOKSAxXJ2kkHHT1EAyRImur0saG-1MufAcoBBBf05GE=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbHpQN1hBaGYyNy1yRG1Lb1pjVVRfM3VYTXNrZ3xBQ3Jtc0tsMXhkUjBSUldzT0FUR2hXQmxhc1B2aFNsVlAxT2RiVjgxNlRjUlhkazNkZEdPWnZ5TXhyU2RGRzZPQXlFMU9fazhfZVZMVzBEeGZGUHEzZ1JYSlFWdmN4RWNKcHlyNHcwTGt5WXBHR3dkSmtZQjhZcw\u0026q=http%3A%2F%2Fwww.Rashed.TV%2F\u0026v=n5dR8hY9NRo","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbHpQN1hBaGYyNy1yRG1Lb1pjVVRfM3VYTXNrZ3xBQ3Jtc0tsMXhkUjBSUldzT0FUR2hXQmxhc1B2aFNsVlAxT2RiVjgxNlRjUlhkazNk