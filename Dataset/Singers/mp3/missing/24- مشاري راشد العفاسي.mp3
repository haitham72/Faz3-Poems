ttps://www.youtube.com/ptracking?ei=w2iVaaz4CMmEoccPi6L16A0\u0026oid=JxAJOkoESHHGWvqKfaWU-Q\u0026plid=AAZLFA3L7eY7DUlY\u0026pltype=content\u0026ptchn=mMcOjsVehVlEOteyrhjI2Q\u0026ptk=youtube_single\u0026video_id=24CFP2O7TbA"},"qoeUrl":{"baseUrl":"https://s.youtube.com/api/stats/qoe?cl=868197613\u0026docid=24CFP2O7TbA\u0026ei=w2iVaaz4CMmEoccPi6L16A0\u0026el=detailpage\u0026event=streamingstats\u0026fexp=\u0026ns=yt\u0026plid=AAZLFA3L7eY7DUlY"},"atrUrl":{"baseUrl":"https://s.youtube.com/api/stats/atr?c=WEB\u0026docid=24CFP2O7TbA\u0026ei=w2iVaaz4CMmEoccPi6L16A0\u0026len=665\u0026ns=yt\u0026plid=AAZLFA3L7eY7DUlY\u0026ver=2\u0026vm=CAMQARgBOjJBSHFpSlRLbjkyY0JGSlFXUnZGM2RRM0dKcjRocHNJRHdNNmdOREJIbEg5LUEtQi1Sd2JTQUx6bG9uaFctOUVrVVhPcW9VdjhBTUx5QlpzZkFFUFU1TGZtUTZxUUZhLUNXS01rYUFfUGNpUFhkcWoyUWdfeDcySjhGOXBuYjFELS1fcWJUeW-4AQE","elapsedMediaTimeSeconds":5},"videostatsScheduledFlushWalltimeSeconds":[10,20,30],"videostatsDefaultFlushIntervalSeconds":40,"youtubeRemarketingUrl":{"baseUrl":"https://www.youtube.com/pagead/viewthroughconversion/962985656/?backend=innertube\u0026cname=1\u0026cver=2_20260213\u0026foc_id=mMcOjsVehVlEOteyrhjI2Q\u0026label=followon_view\u0026ptype=no_rmkt\u0026random=234424987","elapsedMediaTimeSeconds":0}},"videoDetails":{"videoId":"24CFP2O7TbA","title":"المستحيل |  فزاع | مشاري راشد العفاسي - Mishari Alafasy AlMostahel","lengthSeconds":"665","keywords":["Alafasy","Alafasy channel","Shaikh","Mishary","Rashid","قناة العفاسي","العفاسي","شيخ العفاسي"],"channelId":"UCmMcOjsVehVlEOteyrhjI2Q","isOwnerViewing":false,"shortDescription":"🔔 لا تنس دعم القناة بالاشتراك وتفعيل الجرس ليصلك كل جديد.\nاضغط إعجاب وشارك المقطع مع من تحب، فـ الدال على الخير كفاعله.\nحين تنشر تلاوة أو دعاء، فأنت تُعين على ذكر الله وتؤجر بإذن الله، فلعلها تكون سببًا لهداية قلب أو سكينة نفس.\nاستكشف المزيد من التلاوات، والمقاطع الهادفة والمميزة في قوائم التشغيل المتنوعة على القناة.\nبارك الله فيكم، ونفعنا وإياكم بالقرآن العظيم\n\nاشترك الآن في خدمة القرآن :\nhttps://www.youtube.com/@alafasy?sub_confirmation=1\n\nاخترنا لك : 50 تلاوة مميزة للقارئ مشاري راشد العفاسي\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN\u0026feature=shared\n\nمصحف قديم الشيخ مشاري راشد العفاسي\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSqc3yePg5cstFT3lpStFUb1\u0026feature=shared\n\nمصحف كاليفورنيا من صلاة التراويح \nhttps://youtube.com/playlist?list=PL2hoGhz2jBSr0F3k9hIYqsllrqKlMLn1V\u0026feature=shared\n\nالمصحف المرتل الأول الذي سُجل في الكويت ومصر  عام 2003م 1424هـ\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSpGpWPEQv5LjwVlTMYXXxnC\u0026feature=shared\n\nمصحف القرآءات العشر الجديد \nhttps://youtube.com/playlist?list=PL2hoGhz2jBSroDP_SDhYNMCOAkzHozQZo\u0026feature=shared\n\nجميع أناشيد القارئ مشاري راشد العفاسي\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSq-5dulEtVsDxIEBn1BJsrS\u0026feature=shared\n\nالأدعية وأذكار الصباح والمساء والرقية الشرعية\nhttps://youtube.com/playlist?list=PL2hoGhz2jBSqosLJN5ECy3KsgT_Pu8kNX\u0026feature=shared\n\nالمستحيل | مشاري راشد العفاسي - Mishari Alafasy AlMostahel\nمن أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم \nألحان: فايز السعيد\nالكلمات :\nالـمسـتحـيـل يحـبـني يـوم رمـتـه كأن مصيري مرتبط مع مصـيره\n والـياس حـاربني لكـنـي هـزمتـه وايـامـنـا راحـاتـها مـســتــــديره\n عـزي من ابـوي الـكريم اسـتـلمتـه على الـمسار اكملت نـفس الـمسـيره\n الأولـه .. حق الـعرب ماهـضـمته والثـانيه .. انـباي فـي كل ديـره\n وابـوي .. أبـوي الصـيرمي لا عدمته خـذيت منه الأولـه والأخـيره\n\nكم بحر ترهب غبـته .. بس عمته خطير واحب الدروب الخـطيره\n وكم واحدٍ لو ما حشـمني حشمتهماهو على شانه .. على شان غـيره \nوكم واحد لو يجـهل اسمي ، ما لـمته عيون لومي عن شـراته ضـريره\n وكم واحد عليه غيضـي كتـمتـه أسامحه واقول هو و ضـميره \nوكم بيت شاعر كنـي اللي نظمتـه يجذبني اسلوبه وحِسْن تـعـبيره\n وكم صاحب يثـبت معي لا زهمتـه يبـين فـي شر الزمن قبل خـيره \nوكم واحد آحسـسه بأني فـهـمته أقرا في عيـنه ما حوتـه السريـره \nوكم سيف في شوط التحدي لطـمته ونـفوس من تكـره نجاحي كســيره\n وكم ليل أتعـب رمش عيني ما نـمته لين احـتضن جفـني شعاع الظـهيره \nوكم من حزام يرتخي لا احـتزمته ما ينـلبس عنـد الأمــور الكـبـيره \nوكم من جـدار فـي طريقي هدمته وبنيت باحـجاره للاجيـال سـيره\n\nوكم عاقل تسـتـغرب الـناس صـمـتـه كبـير وعقـول الـخـلايق صـغـيره\n وكم حـلـم يتحقـق لا مـني حلـمتـه يثـيـرني يـوم احـلـمه واسـتـثيره \nوكم يوم من عمري يا وقتي خصمته ياما اطولك وايام ناسك قـصـيره \nإنسـان احـس انـه كـفو لا احـترمته نـفسـه غـنـيـه لو يـدينـه فـقـيـره\n وانسـان .. بخـزام الوفـا لو خـزمته نار الغـدر فـي وسط يوفه سـعـيره\n وصاحبي اللي ما حـشـمني ، حشـمته ماهو على شـانه ، على شـان غـيره\n\nالأولـه .. حـق الـعـرب ماهـضـمته والـثـانـيه .. انـباي فـي كل ديـره \nوالـثالثـه .. الـصـيرمـي لا عـدمـتـه خـذيـت مـنه الأولــه والأخـيــره","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/24CFP2O7TbA/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLDDiTIfZFK-Igbou06Q7GQb0mjsww","width":168,"height":94},{"url":"https://i.ytimg.com/vi/24CFP2O7TbA/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLAddE_UNsne3kSMerJC6ps7MEt1AQ","width":196,"height":110},{"url":"https://i.ytimg.com/vi/24CFP2O7TbA/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLBuWPxRQBlsLV5C2FCtJSe6HyqWcg","width":246,"height":138},{"url":"https://i.ytimg.com/vi/24CFP2O7TbA/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLD0OWCm1koFtp853GVSecfYtkrySA","width":336,"height":188},{"url":"https://i.ytimg.com/vi/24CFP2O7TbA/maxresdefault.jpg?v=635b7b6a","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"86251","author":"Alafasy","isLowLatencyLiveStream":false,"isPrivate":false,"isUnpluggedCorpus":false,"latencyClass":"MDE_STREAM_OPTIMIZATIONS_RENDERER_LATENCY_NORMAL","isLiveContent":false},"annotations":[{"playerAnnotationsExpandedRenderer":{"featuredChannel":{"startTimeMs":"0","endTimeMs":"665000","watermark":{"thumbnails":[{"url":"https://i.ytimg.com/an/mMcOjsVehVlEOteyrhjI2Q/featured_channel.jpg?v