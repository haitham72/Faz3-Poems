6,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":630,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":682,"length":65,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":747,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":799,"length":30,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":829,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":881,"length":40,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":921,"length":41,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":962,"length":48,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1010,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1062,"length":1661,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964464,"raisedBackground":4294964464,"additiveBackground":566848069,"textPrimary":4281734666,"textSecondary":4285679414,"invertedBackground":4287576857,"overlayBackground":3426096650},"darkThemeColorPalette":{"baseBackground":4280027394,"raisedBackground":4281734666,"additiveBackground":734620229,"textPrimary":4294633440,"textSecondary":4292851882,"invertedBackground":4293105789,"overlayBackground":3426096650},"colorSampledDescriptionBodyText":{"content":"🔔 لا تنس دعم القناة بالاشتراك وتفعيل الجرس ليصلك كل جديد.\nاضغط إعجاب وشارك المقطع مع من تحب، فـ الدال على الخير كفاعله.\nحين تنشر تلاوة أو دعاء، فأنت تُعين على ذكر الله وتؤجر بإذن الله، فلعلها تكون سببًا لهداية قلب أو سكينة نفس.\nاستكشف المزيد من التلاوات، والمقاطع الهادفة والمميزة في قوائم التشغيل المتنوعة على القناة.\nبارك الله فيكم، ونفعنا وإياكم بالقرآن العظيم\n\nاشترك الآن في خدمة القرآن :\n   / @alafasy  \n\nاخترنا لك : 50 تلاوة مميزة للقارئ مشاري راشد العفاسي\n   • اخترنا لك : 60 تلاوة مميزة للقارئ مشاري را...  \n\nمصحف قديم الشيخ مشاري راشد العفاسي\n   • مصحف قديم الشيخ مشاري راشد العفاسي  \n\nمصحف كاليفورنيا من صلاة التراويح \n   • القرآن الكريم كاملاً من صلاة من التراويح و...  \n\nالمصحف المرتل الأول الذي سُجل في الكويت ومصر  عام 2003م 1424هـ\n   • المصحف المرتل الأول 2003م 1424هـ للشيخ مشا...  \n\nمصحف القرآءات العشر الجديد \n   • مصحف القراءات العشر 1445هـ - 2024م - الشيخ...  \n\nجميع أناشيد القارئ مشاري راشد العفاسي\n   • قصائد وأناشيد | مشاري راشد العفاسي  \n\nالأدعية وأذكار الصباح والمساء والرقية الشرعية\n   • Duaa' Mishary Alafasy أدعية وأذكار | مشاري...  \n\nالمستحيل | مشاري راشد العفاسي - Mishari Alafasy AlMostahel\nمن أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم \nألحان: فايز السعيد\nالكلمات :\nالـمسـتحـيـل يحـبـني يـوم رمـتـه كأن مصيري مرتبط مع مصـيره\n والـياس حـاربني لكـنـي هـزمتـه وايـامـنـا راحـاتـها مـســتــــديره\n عـزي من ابـوي الـكريم اسـتـلمتـه على الـمسار اكملت نـفس الـمسـيره\n الأولـه .. حق الـعرب ماهـضـمته والثـانيه .. انـباي فـي كل ديـره\n وابـوي .. أبـوي الصـيرمي لا عدمته خـذيت منه الأولـه والأخـيره\n\nكم بحر ترهب غبـته .. بس عمته خطير واحب الدروب الخـطيره\n وكم واحدٍ لو ما حشـمني حشمتهماهو على شانه .. على شان غـيره \nوكم واحد لو يجـهل اسمي ، ما لـمته عيون لومي عن شـراته ضـريره\n وكم واحد عليه غيضـي كتـمتـه أسامحه واقول هو و ضـميره \nوكم بيت شاعر كنـي اللي نظمتـه يجذبني اسلوبه وحِسْن تـعـبيره\n وكم صاحب يثـبت معي لا زهمتـه يبـين فـي شر الزمن قبل خـيره \nوكم واحد آحسـسه بأني فـهـمته أقرا في عيـنه ما حوتـه السريـره \nوكم سيف في شوط التحدي لطـمته ونـفوس من تكـره نجاحي كســيره\n وكم ليل أتعـب رمش عيني ما نـمته لين احـتضن جفـني شعاع الظـهيره \nوكم من حزام يرتخي لا احـتزمته ما ينـلبس عنـد الأمــور الكـبـيره \nوكم من جـدار فـي طريقي هدمته وبنيت باحـجاره للاجيـال سـيره\n\nوكم عاقل تسـتـغرب الـناس صـمـتـه كبـير وعقـول الـخـلايق صـغـيره\n وكم حـلـم يتحقـق لا مـني حلـمتـه يثـيـرني يـوم احـلـمه واسـتـثيره \nوكم يوم من عمري يا وقتي خصمته ياما اطولك وايام ناسك قـصـيره \nإنسـان احـس انـه كـفو لا احـترمته نـفسـه غـنـيـه لو يـدينـه فـقـيـره\n وانسـان .. بخـزام الوفـا لو خـزمته نار الغـدر فـي وسط يوفه سـعـيره\n وصاحبي اللي ما حـشـمني ، حشـمته ماهو على شـانه ، على شـان غـيره\n\nالأولـه .. حـق الـعـرب ماهـضـمته والـثـانـيه .. انـباي فـي كل ديـره \nوالـثالثـه .. الـصـيرمـي لا عـدمـتـه خـذيـت مـنه الأولــه والأخـيــره","commandRuns":[{"startIndex":394,"length":15,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBMQ040EGAUiEwj6667uwOKSAxW_fEECHQ7EPODKAQRTSHvS","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCmMcOjsVehVlEOteyrhjI2Q","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCmMcOjsVehVlEOteyrhjI2Q","canonicalBaseUrl":"/channel/UCmMcOjsVehVlEOteyrhjI2Q"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: @alafasy"}}},{"startIndex":464,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBMQ040EGAUiEwj6667uwOKSAxW_fEECHQ7EPODKAQRTSHvS","commandMetadata":{"webCommandMetadata":{"url":"/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN","webPageType":"WEB_PAGE_TYPE_PLAYLIST","rootVe":5754,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"VLPL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN","canonicalBaseUrl":"/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: اخترنا لك : 60 تلاوة مميزة للقارئ مشاري راشد العفاسي"}}},{"startIndex":553,"length":41,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBMQ040EGAUiEwj6667uwOKSAxW_fEECHQ7EPODKAQRTSHvS","commandMetadata":{"webCommandMetadata":{"url":"/playlist?list=PL2hoGhz2jBSqc3yePg5cstFT3lpStFUb1","webPageType":"WEB_PAGE_TYPE_PLAYLIST","rootVe":5754,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"VLPL2hoGhz2jBSqc3yePg5cstFT3lpStFUb1","canonicalBaseUrl":"/playlist?list=PL2hoGhz2jBSqc3yePg5cstFT3lpStFUb1"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel"