tTextDecorator":{"startIndex":1565,"length":52,"backgroundCornerRadius":8,"bottomPadding":1,"highlightTextDecoratorExtensions":{"highlightTextDecoratorColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":452984831},{"key":"USER_INTERFACE_THEME_LIGHT","value":218103808}]}}}}},{"textDecorator":{"highlightTextDecorator":{"startIndex":1657,"length":41,"backgroundCornerRadius":8,"bottomPadding":1,"highlightTextDecoratorExtensions":{"highlightTextDecoratorColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":452984831},{"key":"USER_INTERFACE_THEME_LIGHT","value":218103808}]}}}}},{"textDecorator":{"highlightTextDecorator":{"startIndex":1746,"length":52,"backgroundCornerRadius":8,"bottomPadding":1,"highlightTextDecoratorExtensions":{"highlightTextDecoratorColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":452984831},{"key":"USER_INTERFACE_THEME_LIGHT","value":218103808}]}}}}}]},"headerRuns":[{"startIndex":0,"length":1130,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1130,"length":15,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1145,"length":55,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1200,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1252,"length":37,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1289,"length":41,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1330,"length":36,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1366,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1418,"length":65,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1483,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1535,"length":30,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1565,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1617,"length":40,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1657,"length":41,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1698,"length":48,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1746,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294965232,"raisedBackground":4294965232,"additiveBackground":566853445,"textPrimary":4281736458,"textSecondary":4285419834,"invertedBackground":4287581465,"overlayBackground":3426098442},"darkThemeColorPalette":{"baseBackground":4280028674,"raisedBackground":4281736458,"additiveBackground":734625605,"textPrimary":4294634720,"textSecondary":4292723372,"invertedBackground":4293110652,"overlayBackground":3426098442},"colorSampledDescriptionBodyText":{"content":"من أشعار سمو الشيخ حمدان بن محمد بن راشد آل مكتوم\nألحان : فايز السعيد\nتوزيع : د. عدنان عبدالله\n\nالكلمات :\nبالهـدى والبر والتـقوى يا ربّــى زدها\nنفس مؤمن شفّـته بالذكر ليست عطبه\n\nأدرى أن المقبلات أشر وأقسى وأدهى\nوالعمـر مـرّه وأنـا لا يمكـن افرط به\n\nوأجمل اللحظات وأغلاها معى وأسعدها\nلحظةٍ راس قلمى فأوراقـى أخطط به\n\nالقصيدة دون حبكـه فى نظر ناقـدها\nمثل من صَلَّى صلاة الجمعة بلا خطبة\n\nوالبيوت اللى هجوسـى ماهو يرددها\nمن ملـف الذاكـرة ثـلثيـنها منشـطـبه\n\nصاحب النعمة ما يبلش غير فى حاسدها\nودّى أعرف حاسد النعمة فقط ما خطبه؟\n\nأيّها الإنسـان نفـسك للـعـلا جنّــدها\nواستمع شور المجرّب جيّدا واحتط به\n\nوانظر الحطّاب نفسه كيف هو عوّدها\nيْتخيّر فى الحطب ما كل عود أيحطبه\n\nلا تكن كـالبـير ما تـروى سوى قاصدها\nولتكن كالغـيم تـروى كل نفـسٍ رطـبه\n🔔 لا تنس دعم القناة بالاشتراك وتفعيل الجرس ليصلك كل جديد.\nاضغط إعجاب وشارك المقطع مع من تحب، فـ الدال على الخير كفاعله.\nحين تنشر تلاوة أو دعاء، فأنت تُعين على ذكر الله وتؤجر بإذن الله، فلعلها تكون سببًا لهداية قلب أو سكينة نفس.\nاستكشف المزيد من التلاوات، والمقاطع الهادفة والمميزة في قوائم التشغيل المتنوعة على القناة.\nبارك الله فيكم، ونفعنا وإياكم بالقرآن العظيم\n\nاشترك الآن في خدمة القرآن :\n   / @alafasy  \n\nاخترنا لك : 50 تلاوة مميزة للقارئ مشاري راشد العفاسي\n   • اخترنا لك : 60 تلاوة مميزة للقارئ مشاري را...  \n\nمصحف قديم الشيخ مشاري راشد العفاسي\n   • مصحف قديم الشيخ مشاري راشد العفاسي  \n\nمصحف كاليفورنيا من صلاة التراويح \n   • القرآن الكريم كاملاً من صلاة من التراويح و...  \n\nالمصحف المرتل الأول الذي سُجل في الكويت ومصر  عام 2003م 1424هـ\n   • المصحف المرتل الأول 2003م 1424هـ للشيخ مشا...  \n\nمصحف القرآءات العشر الجديد \n   • مصحف القراءات العشر 1445هـ - 2024م - الشيخ...  \n\nجميع أناشيد القارئ مشاري راشد العفاسي\n   • قصائد وأناشيد | مشاري راشد العفاسي  \n\nالأدعية وأذكار الصباح والمساء والرقية الشرعية\n   • Duaa' Mishary Alafasy أدعية وأذكار | مشاري...  ","commandRuns":[{"startIndex":1130,"length":15,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAYiEwjv5rvwwOKSAxWlKAYAHRHAOX_KAQRpXkjn","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCmMcOjsVehVlEOteyrhjI2Q","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCmMcOjsVehVlEOteyrhjI2Q","canonicalBaseUrl":"/channel/UCmMcOjsVehVlEOteyrhjI2Q"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: @alafasy"}}},{"startIndex":1200,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAYiEwjv5rvwwOKSAxWlKAYAHRHAOX_KAQRpXkjn","commandMetadata":{"webCommandMetadata":{"url":"/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN","webPageType":"WEB_PAGE_TYPE_PLAYLIST","rootVe":5754,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"VLPL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN","canonicalBaseUrl":"/playlist?list=PL2hoGhz2jBSoDujIR7wYVwDBr71E7zhPN"}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: اخترنا لك : 60 تلاوة ممي